@using System.Globalization
@using System.Net.Http.Json
@using PoultryFarm.Marketplace.Services
@rendermode InteractiveServer

@page "/activities"

@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject GuestSession GuestSession
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="social-feed-page">
    <div class="social-feed-shell">
        <header class="social-feed-intro">
            <div>
                <p class="social-kicker">Poultry Zone</p>
                <h1>Farm Blog</h1>
            </div>
            <a class="social-back" href="/">← Catalog</a>
        </header>

        @if (_loading)
        {
            <div class="social-state">Loading posts…</div>
        }
        else if (_posts.Count == 0)
        {
            <div class="social-state">No posts yet. Check back when farms publish updates.</div>
        }
        else
        {
            <div class="social-feed">
                @foreach (var post in _posts)
                {
                    var previewComments = NewestFirst(post.Comments).Take(2).ToList();
                    var hasMoreComments = post.Comments.Count > 2 || post.CommentCount > 2;
                    <article class="social-card @(FocusPostId == post.Id ? "is-focus" : null)" id="@($"post-{post.Id}")" @key="post.Id">
                        <header class="social-card-head">
                            <div class="social-avatar" aria-hidden="true">@Initials(post.FarmName)</div>
                            <div class="social-card-meta">
                                <div class="social-name-row">
                                    <strong>@post.FarmName</strong>
                                    <span class="social-verified" title="Verified farm" aria-label="Verified farm">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#2196F3" d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68z" />
                                            <path fill="#fff" d="M10.09 16.72l-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48z" />
                                        </svg>
                                    </span>
                                </div>
                                <span>@(post.PublishedAt?.ToLocalTime().ToString("d MMM yyyy · h:mm tt") ?? "Just now")</span>
                            </div>
                        </header>

                        <div class="social-card-copy">
                            @if (!string.IsNullOrWhiteSpace(post.Title) && !string.Equals(post.Title, post.Body, StringComparison.Ordinal))
                            {
                                <h2>@post.Title</h2>
                            }
                            <p class="@(_expandedPosts.Contains(post.Id) || !BodyOverflows(post.Body) ? null : "is-collapsed")">@post.Body</p>
                            @if (BodyOverflows(post.Body) && !_expandedPosts.Contains(post.Id))
                            {
                                <button type="button" class="social-see-more" @onclick="() => _expandedPosts.Add(post.Id)">See more</button>
                            }
                        </div>

                        @{
                            var images = PostImages(post);
                        }
                        @if (images.Count > 0)
                        {
                            <div class="social-album count-@AlbumCount(images.Count)">
                                @for (var index = 0; index < Math.Min(images.Count, 5); index++)
                                {
                                    var imageIndex = index;
                                    var hiddenCount = images.Count - 5;
                                    <button type="button" @onclick="() => OpenViewer(post.Id, imageIndex)">
                                        <img src="@ResolveMediaUrl(images[imageIndex])" alt="@post.Title" loading="lazy" />
                                        @if (imageIndex == 4 && hiddenCount > 0)
                                        {
                                            <span class="social-album-more">+@hiddenCount</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        <div class="social-card-counts">
                            <button type="button" class="social-count-btn" @onclick="() => OpenCommentsDialog(post.Id)">
                                <span>@FormatCount(post.LikeCount) @(post.LikeCount == 1 ? "like" : "likes")</span>
                            </button>
                            <button type="button" class="social-count-btn" @onclick="() => OpenCommentsDialog(post.Id)">
                                <span>@FormatCount(post.CommentCount) @(post.CommentCount == 1 ? "comment" : "comments")</span>
                            </button>
                            <span>@FormatCount(post.ShareCount) @(post.ShareCount == 1 ? "share" : "shares")</span>
                        </div>

                        <div class="social-card-actions">
                            <button type="button"
                                    class="social-action @(post.LikedByMe ? "is-active" : null)"
                                    disabled="@(_likingId == post.Id)"
                                    @onclick="() => LikeAsync(post)">
                                @(post.LikedByMe ? "Liked" : "Like")
                            </button>
                            <button type="button" class="social-action" @onclick="() => OpenCommentsDialog(post.Id)">
                                Comment
                            </button>
                            <button type="button"
                                    class="social-action"
                                    disabled="@(_sharingId == post.Id)"
                                    @onclick="() => ShareAsync(post)">
                                Share
                            </button>
                        </div>

                        @if (_shareFlashId == post.Id)
                        {
                            <p class="social-flash">Link copied — paste it anywhere to share this post.</p>
                        }

                        <div class="social-comments social-comments-preview">
                            @if (previewComments.Count == 0)
                            {
                                <p class="social-comments-empty">Be the first to comment.</p>
                            }
                            else
                            {
                                @foreach (var comment in previewComments)
                                {
                                    @RenderComment(post, comment, isReply: false, compact: true)
                                }
                            }

                            @if (hasMoreComments)
                            {
                                <button type="button" class="social-see-more" @onclick="() => OpenCommentsDialog(post.Id)">
                                    See more comments
                                </button>
                            }

                            <form class="social-composer social-composer-compact" @onsubmit="() => CommentAsync(post.Id, null)" @onsubmit:preventDefault>
                                <div class="social-composer-fields">
                                    <input type="text"
                                           maxlength="80"
                                           placeholder="Your name"
                                           autocomplete="nickname"
                                           value="@AuthorSeed(post.Id)"
                                           @key="@($"author-{post.Id}-{AuthorEpoch(post.Id)}")"
                                           @oninput="e => OnAuthorInput(post.Id, e)"
                                           required />
                                    <textarea rows="2"
                                              maxlength="2000"
                                              placeholder="Write a comment…"
                                              value="@DraftSeed(post.Id)"
                                              @key="@($"draft-{post.Id}-{DraftEpoch(post.Id)}")"
                                              @oninput="e => OnDraftInput(post.Id, e)"
                                              required></textarea>
                                </div>
                                <div class="social-composer-foot">
                                    @if (_commentErrors.TryGetValue(post.Id, out var error) && !string.IsNullOrWhiteSpace(error))
                                    {
                                        <p class="social-error">@error</p>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <button class="btn primary" type="submit" disabled="@(_commentingKey == post.Id.ToString())">
                                        @(_commentingKey == post.Id.ToString() ? "Posting…" : "Post")
                                    </button>
                                </div>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (_dialogPost is { } dialogPost)
{
    <div class="social-dialog-backdrop" @onclick="CloseCommentsDialog">
        <div class="social-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Comments">
            <header class="social-dialog-head">
                <div>
                    <strong>@dialogPost.FarmName</strong>
                    <span>Comments · @FormatCount(dialogPost.CommentCount)</span>
                </div>
                <button type="button" class="social-dialog-close" @onclick="CloseCommentsDialog" aria-label="Close">×</button>
            </header>

            <div class="social-dialog-body">
                @if (dialogPost.Comments.Count == 0)
                {
                    <p class="social-comments-empty">No comments yet — start the conversation.</p>
                }
                else
                {
                    @foreach (var comment in NewestFirst(dialogPost.Comments))
                    {
                        @RenderComment(dialogPost, comment, isReply: false, compact: true)
                    }
                }
            </div>

            <footer class="social-dialog-foot">
                <form class="social-composer" @onsubmit="() => CommentAsync(dialogPost.Id, null)" @onsubmit:preventDefault>
                    <p class="social-composer-label">Comment as a guest — enter your name and message.</p>
                    <div class="social-composer-fields">
                        <input type="text"
                               maxlength="80"
                               placeholder="Your name"
                               value="@AuthorSeed(dialogPost.Id)"
                               @key="@($"author-{dialogPost.Id}-{AuthorEpoch(dialogPost.Id)}")"
                               @oninput="e => OnAuthorInput(dialogPost.Id, e)"
                               required />
                        <textarea rows="2"
                                  maxlength="2000"
                                  placeholder="Write a comment…"
                                  value="@DraftSeed(dialogPost.Id)"
                                  @key="@($"draft-{dialogPost.Id}-{DraftEpoch(dialogPost.Id)}")"
                                  @oninput="e => OnDraftInput(dialogPost.Id, e)"
                                  required></textarea>
                    </div>
                    <div class="social-composer-foot">
                        @if (_commentErrors.TryGetValue(dialogPost.Id, out var dialogError) && !string.IsNullOrWhiteSpace(dialogError))
                        {
                            <p class="social-error">@dialogError</p>
                        }
                        else
                        {
                            <span></span>
                        }
                        <button class="btn primary" type="submit" disabled="@(_commentingKey == dialogPost.Id.ToString())">
                            @(_commentingKey == dialogPost.Id.ToString() ? "Posting…" : "Post comment")
                        </button>
                    </div>
                </form>
            </footer>
        </div>
    </div>
}

@if (_repliesDialog is { } repliesDialog)
{
    var (repliesPost, repliesParent) = repliesDialog;
    <div class="social-dialog-backdrop" @onclick="CloseRepliesDialog">
        <div class="social-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Replies">
            <header class="social-dialog-head">
                <div>
                    <strong>Replies</strong>
                    <span>@FormatCount(repliesParent.Replies.Count) @(repliesParent.Replies.Count == 1 ? "reply" : "replies") to @repliesParent.AuthorName</span>
                </div>
                <button type="button" class="social-dialog-close" @onclick="CloseRepliesDialog" aria-label="Close">×</button>
            </header>

            <div class="social-dialog-body">
                <div class="social-dialog-parent">
                    @RenderComment(repliesPost, repliesParent with { Replies = [] }, isReply: false, compact: false, showReplies: false)
                </div>
                <div class="social-dialog-replies social-replies">
                    @if (repliesParent.Replies.Count == 0)
                    {
                        <p class="social-comments-empty">No replies yet.</p>
                    }
                    else
                    {
                        @foreach (var reply in NewestFirst(repliesParent.Replies))
                        {
                            @RenderComment(repliesPost, reply, isReply: true, compact: false, showReplies: false, threadRootId: repliesParent.Id)
                        }
                    }
                </div>
            </div>

            <footer class="social-dialog-foot">
                <form class="social-composer" @onsubmit="() => CommentAsync(repliesPost.Id, repliesParent.Id)" @onsubmit:preventDefault>
                    <p class="social-composer-label">Reply as a guest — enter your name and message.</p>
                    <div class="social-composer-fields">
                        <input type="text"
                               maxlength="80"
                               placeholder="Your name"
                               value="@AuthorSeed(repliesPost.Id)"
                               @key="@($"author-{repliesPost.Id}-{AuthorEpoch(repliesPost.Id)}")"
                               @oninput="e => OnAuthorInput(repliesPost.Id, e)"
                               required />
                        <textarea rows="2"
                                  maxlength="2000"
                                  placeholder="@($"Reply to {repliesParent.AuthorName}…")"
                                  value="@ReplySeed(repliesParent.Id)"
                                  @key="@($"reply-{repliesParent.Id}-{ReplyEpoch(repliesParent.Id)}")"
                                  @oninput="e => OnReplyDraftInput(repliesParent.Id, e)"
                                  required></textarea>
                    </div>
                    <div class="social-composer-foot">
                        @if (_replyErrors.TryGetValue(repliesParent.Id, out var repliesError) && !string.IsNullOrWhiteSpace(repliesError))
                        {
                            <p class="social-error">@repliesError</p>
                        }
                        else
                        {
                            <span></span>
                        }
                        <button class="btn primary" type="submit" disabled="@(_commentingKey == repliesParent.Id.ToString())">
                            @(_commentingKey == repliesParent.Id.ToString() ? "Posting…" : "Post reply")
                        </button>
                    </div>
                </form>
            </footer>
        </div>
    </div>
}

@if (_viewerPostId is Guid viewerPostId)
{
    var viewerPost = _posts.FirstOrDefault(x => x.Id == viewerPostId);
    var viewerImages = viewerPost is null ? [] : PostImages(viewerPost);
    if (viewerImages.Count > 0)
    {
        var safeIndex = Math.Clamp(_viewerIndex, 0, viewerImages.Count - 1);
        <div class="social-viewer" role="dialog" aria-modal="true" aria-label="Post photos">
            <button type="button" class="social-viewer-close" @onclick="CloseViewer" aria-label="Close">×</button>
            @if (viewerImages.Count > 1)
            {
                <button type="button" class="social-viewer-nav is-prev" @onclick="() => StepViewer(-1)" aria-label="Previous photo">‹</button>
            }
            <img src="@ResolveMediaUrl(viewerImages[safeIndex])" alt="@(viewerPost?.Title ?? "Post photo")" />
            @if (viewerImages.Count > 1)
            {
                <button type="button" class="social-viewer-nav is-next" @onclick="() => StepViewer(1)" aria-label="Next photo">›</button>
                <span class="social-viewer-count">@(safeIndex + 1) / @viewerImages.Count</span>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "post")]
    public Guid? FocusPostId { get; set; }

    private static readonly string[] ReactionEmojis = ["👍", "❤️", "😂", "😮", "😢", "🔥"];

    private bool _loading = true;
    private string? _commentingKey;
    private bool _skipRender;
    private Guid? _likingId;
    private Guid? _sharingId;
    private Guid? _shareFlashId;
    private Guid? _replyingTo;
    private Guid? _reactingCommentId;
    private Guid? _deletingCommentId;
    private Guid? _commentsDialogPostId;
    private Guid? _repliesDialogPostId;
    private Guid? _repliesDialogParentId;
    private Guid? _reactionHoverId;
    private Guid? _pinnedReactionCommentId;
    private Guid? _dismissedReactionCommentId;
    private List<ActivityDto> _posts = [];
    private Dictionary<Guid, string> _drafts = new();
    private Dictionary<Guid, string> _draftSeeds = new();
    private Dictionary<Guid, int> _draftEpochs = new();
    private Dictionary<Guid, string> _replyDrafts = new();
    private Dictionary<Guid, string> _replySeeds = new();
    private Dictionary<Guid, int> _replyEpochs = new();
    private Dictionary<Guid, string> _authorNames = new();
    private Dictionary<Guid, string> _authorSeeds = new();
    private Dictionary<Guid, int> _authorEpochs = new();
    private Dictionary<Guid, string> _commentErrors = new();
    private Dictionary<Guid, string> _replyErrors = new();
    private string ApiBase => (Configuration["Api:PublicBaseUrl"] ?? Configuration["Api:BaseUrl"] ?? "http://localhost:5100").TrimEnd('/');
    private bool _pageScrollLocked;
    private readonly HashSet<Guid> _expandedPosts = [];
    private Guid? _viewerPostId;
    private int _viewerIndex;

    private ActivityDto? _dialogPost =>
        _commentsDialogPostId is Guid id ? _posts.FirstOrDefault(x => x.Id == id) : null;

    private (ActivityDto Post, CommentDto Parent)? _repliesDialog
    {
        get
        {
            if (_repliesDialogPostId is not Guid postId || _repliesDialogParentId is not Guid parentId)
            {
                return null;
            }

            var post = _posts.FirstOrDefault(x => x.Id == postId);
            var parent = post?.Comments.FirstOrDefault(x => x.Id == parentId);
            return post is null || parent is null ? null : (post, parent);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await GuestSession.LoadAsync();
        await LoadAsync();
        if (FocusPostId is Guid focusId)
        {
            OpenCommentsDialog(focusId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncPageScrollLockAsync();

        if (!firstRender || FocusPostId is null) return;
        try
        {
            await Js.InvokeVoidAsync("eval", $"document.getElementById('post-{FocusPostId}')?.scrollIntoView({{behavior:'smooth',block:'start'}})");
        }
        catch
        {
            // Ignore if JS unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_pageScrollLocked)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("marketplaceUi.lockPageScroll", false);
        }
        catch
        {
            // Ignore if JS unavailable.
        }
    }

    private async Task SyncPageScrollLockAsync()
    {
        var lockScroll = _dialogPost is not null || _repliesDialog is not null || _viewerPostId is not null;
        if (lockScroll == _pageScrollLocked)
        {
            return;
        }

        _pageScrollLocked = lockScroll;
        try
        {
            await Js.InvokeVoidAsync("marketplaceUi.lockPageScroll", lockScroll);
        }
        catch
        {
            _pageScrollLocked = false;
        }
    }

    private RenderFragment RenderComment(
        ActivityDto post,
        CommentDto comment,
        bool isReply,
        bool compact,
        bool showReplies = true,
        Guid? threadRootId = null) => __builder =>
    {
        var replyParentId = threadRootId ?? comment.Id;
        var showPicker = _reactionHoverId == comment.Id || _pinnedReactionCommentId == comment.Id;
        <div class="@(isReply ? "social-comment is-reply" : "social-comment")" @key="comment.Id">
            <div class="social-avatar sm" aria-hidden="true">@Initials(comment.AuthorName)</div>
            <div class="social-comment-main">
                <div class="social-comment-interact @(_dismissedReactionCommentId == comment.Id ? "is-reaction-dismissed" : null)"
                     @onmouseenter="() => SetReactionHover(comment.Id)"
                     @onmouseleave="() => ClearReactionHover(comment.Id)">
                    <div class="social-comment-bubble">
                        <span class="social-name-row">
                            <strong>@comment.AuthorName</strong>
                            @if (comment.AuthorCompanyId == post.CompanyId)
                            {
                                <span class="social-verified" title="Verified farm" aria-label="Verified farm">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path fill="#2196F3" d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68z" />
                                        <path fill="#fff" d="M10.09 16.72l-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48z" />
                                    </svg>
                                </span>
                            }
                        </span>
                        <p>@comment.Body</p>
                        <time>@comment.CreatedAt.ToLocalTime().ToString("g")</time>
                    </div>

                    <div class="social-comment-toolbar">
                        @if (comment.Reactions.Count > 0)
                        {
                            <div class="social-reaction-chips">
                                @foreach (var reaction in comment.Reactions)
                                {
                                    <button type="button"
                                            class="social-reaction-chip @(reaction.ReactedByMe ? "is-mine" : null)"
                                            disabled="@(_reactingCommentId == comment.Id)"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => ReactAsync(post.Id, comment.Id, reaction.Emoji)"
                                            @onclick:stopPropagation="true">
                                        <span>@reaction.Emoji</span>
                                        <span>@FormatCount(reaction.Count)</span>
                                    </button>
                                }
                            </div>
                        }
                        <div class="social-comment-tools">
                            <div class="social-reaction-picker @(showPicker ? "is-visible" : null)" title="React">
                                @foreach (var emoji in ReactionEmojis)
                                {
                                    var picked = emoji;
                                    <button type="button"
                                            class="social-reaction-add"
                                            disabled="@(_reactingCommentId == comment.Id)"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => ReactAsync(post.Id, comment.Id, picked)"
                                            @onclick:stopPropagation="true">@picked</button>
                                }
                            </div>
                            <button type="button"
                                    class="social-reply-btn"
                                    @onclick="() => PinReactionPicker(comment.Id)"
                                    @onclick:stopPropagation="true">
                                React
                            </button>
                            <button type="button" class="social-reply-btn" @onclick="() => ToggleReply(comment.Id, comment.AuthorName)">
                                @(_replyingTo == comment.Id ? "Cancel" : "Reply")
                            </button>
                            @if (comment.CanDelete)
                            {
                                <button type="button"
                                        class="social-reply-btn is-danger"
                                        disabled="@(_deletingCommentId == comment.Id)"
                                        @onclick="() => DeleteCommentAsync(post.Id, comment.Id)">
                                    @(_deletingCommentId == comment.Id ? "Deleting…" : "Delete")
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @if (showReplies && !isReply && comment.Replies.Count == 1)
                {
                    <div class="social-replies">
                        @RenderComment(post, comment.Replies[0], isReply: true, compact: compact, showReplies: false, threadRootId: comment.Id)
                    </div>
                }
                else if (showReplies && !isReply && comment.Replies.Count > 1)
                {
                    <button type="button" class="social-see-more is-inline is-strong" @onclick="() => OpenRepliesDialog(post.Id, comment.Id)">
                        See all replies
                    </button>
                }

                @if (_replyingTo == comment.Id)
                {
                    <form class="social-composer social-composer-reply" @onsubmit="() => CommentAsync(post.Id, replyParentId, comment.Id)" @onsubmit:preventDefault>
                        <div class="social-composer-fields">
                            <input type="text"
                                   maxlength="80"
                                   placeholder="Your name"
                                   value="@AuthorSeed(post.Id)"
                                   @key="@($"author-{post.Id}-{AuthorEpoch(post.Id)}")"
                                   @oninput="e => OnAuthorInput(post.Id, e)"
                                   required />
                            <textarea rows="2"
                                      maxlength="2000"
                                      placeholder="@($"Reply to {comment.AuthorName}…")"
                                      value="@ReplySeed(comment.Id)"
                                      @key="@($"reply-{comment.Id}-{ReplyEpoch(comment.Id)}")"
                                      @oninput="e => OnReplyDraftInput(comment.Id, e)"
                                      required></textarea>
                        </div>
                        <div class="social-composer-foot">
                            @if (_replyErrors.TryGetValue(comment.Id, out var replyError) && !string.IsNullOrWhiteSpace(replyError))
                            {
                                <p class="social-error">@replyError</p>
                            }
                            else
                            {
                                <span></span>
                            }
                            <button class="btn primary" type="submit" disabled="@(_commentingKey == comment.Id.ToString())">
                                @(_commentingKey == comment.Id.ToString() ? "Posting…" : "Post reply")
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    };

    private async Task LoadAsync()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        try
        {
            var reactor = Uri.EscapeDataString(GuestSession.ReactorKey ?? string.Empty);
            _posts = await client.GetFromJsonAsync<List<ActivityDto>>($"/api/marketplace/activities?reactorKey={reactor}") ?? [];
            foreach (var post in _posts)
            {
                _drafts.TryAdd(post.Id, string.Empty);
                _draftSeeds.TryAdd(post.Id, _drafts[post.Id]);
                if (!_authorNames.ContainsKey(post.Id))
                {
                    var name = GuestSession.DisplayName ?? string.Empty;
                    _authorNames[post.Id] = name;
                    _authorSeeds[post.Id] = name;
                }
            }
        }
        catch
        {
            _posts = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCommentsDialog(Guid postId)
    {
        _commentsDialogPostId = postId;
        _repliesDialogPostId = null;
        _repliesDialogParentId = null;
        _replyingTo = null;
    }

    private void CloseCommentsDialog()
    {
        _commentsDialogPostId = null;
        _replyingTo = null;
    }

    private void OpenRepliesDialog(Guid postId, Guid parentCommentId)
    {
        _repliesDialogPostId = postId;
        _repliesDialogParentId = parentCommentId;
        _replyingTo = null;
        _replyDrafts.TryAdd(parentCommentId, string.Empty);
    }

    private void CloseRepliesDialog()
    {
        _repliesDialogPostId = null;
        _repliesDialogParentId = null;
        _replyingTo = null;
    }

    private void SetReactionHover(Guid commentId)
    {
        if (_dismissedReactionCommentId == commentId)
        {
            return;
        }

        _reactionHoverId = commentId;
    }

    private void ClearReactionHover(Guid commentId)
    {
        if (_dismissedReactionCommentId == commentId)
        {
            _dismissedReactionCommentId = null;
        }

        if (_reactionHoverId == commentId && _pinnedReactionCommentId != commentId)
        {
            _reactionHoverId = null;
        }
    }

    private void DismissReactionPicker(Guid commentId)
    {
        _dismissedReactionCommentId = commentId;
        if (_reactionHoverId == commentId)
        {
            _reactionHoverId = null;
        }

        if (_pinnedReactionCommentId == commentId)
        {
            _pinnedReactionCommentId = null;
        }
    }

    private void PinReactionPicker(Guid commentId)
    {
        _pinnedReactionCommentId = _pinnedReactionCommentId == commentId ? null : commentId;
        _reactionHoverId = commentId;
    }

    private void ToggleReply(Guid commentId, string? authorName = null)
    {
        _replyingTo = _replyingTo == commentId ? null : commentId;
        _replyDrafts.TryAdd(commentId, string.Empty);
    }

    private string GetDraft(Guid id) => _drafts.TryGetValue(id, out var value) ? value : string.Empty;
    private string DraftSeed(Guid id) => _draftSeeds.TryGetValue(id, out var value) ? value : string.Empty;
    private int DraftEpoch(Guid id) => _draftEpochs.TryGetValue(id, out var value) ? value : 0;
    private string GetReplyDraft(Guid id) => _replyDrafts.TryGetValue(id, out var value) ? value : string.Empty;
    private string ReplySeed(Guid id) => _replySeeds.TryGetValue(id, out var value) ? value : string.Empty;
    private int ReplyEpoch(Guid id) => _replyEpochs.TryGetValue(id, out var value) ? value : 0;
    private string GetAuthor(Guid id) => _authorNames.TryGetValue(id, out var value) ? value : string.Empty;
    private string AuthorSeed(Guid id) => _authorSeeds.TryGetValue(id, out var value) ? value : string.Empty;
    private int AuthorEpoch(Guid id) => _authorEpochs.TryGetValue(id, out var value) ? value : 0;

    private void OnAuthorInput(Guid id, ChangeEventArgs e) => RememberInput(() => _authorNames[id] = e.Value?.ToString() ?? string.Empty);
    private void OnDraftInput(Guid id, ChangeEventArgs e) => RememberInput(() => _drafts[id] = e.Value?.ToString() ?? string.Empty);
    private void OnReplyDraftInput(Guid id, ChangeEventArgs e) => RememberInput(() => _replyDrafts[id] = e.Value?.ToString() ?? string.Empty);

    private void RememberInput(Action write)
    {
        write();
        _skipRender = true;
    }

    protected override bool ShouldRender()
    {
        if (!_skipRender)
        {
            return true;
        }

        _skipRender = false;
        return false;
    }

    private void ResetDraft(Guid id)
    {
        _drafts[id] = string.Empty;
        _draftSeeds[id] = string.Empty;
        _draftEpochs[id] = DraftEpoch(id) + 1;
    }

    private void ResetReplyDraft(Guid id)
    {
        _replyDrafts[id] = string.Empty;
        _replySeeds[id] = string.Empty;
        _replyEpochs[id] = ReplyEpoch(id) + 1;
    }

    private static List<CommentDto> NewestFirst(IEnumerable<CommentDto> comments) =>
        comments.OrderByDescending(c => c.CreatedAt).ToList();

    private static string FormatCount(int count)
    {
        if (count < 1000)
        {
            return count.ToString(CultureInfo.InvariantCulture);
        }

        var thousands = count / 1000d;
        return thousands % 1 == 0
            ? $"{(int)thousands}K"
            : string.Create(CultureInfo.InvariantCulture, $"{thousands:0.#}K");
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private async Task LikeAsync(ActivityDto post)
    {
        _likingId = post.Id;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync($"/api/marketplace/activities/{post.Id}/likes", new
            {
                reactorKey = GuestSession.ReactorKey
            });
            if (!response.IsSuccessStatusCode) return;

            var result = await response.Content.ReadFromJsonAsync<LikeResponse>();
            if (result is null) return;

            var index = _posts.FindIndex(x => x.Id == post.Id);
            if (index >= 0)
            {
                _posts[index] = _posts[index] with { LikeCount = result.LikeCount, LikedByMe = result.LikedByMe };
            }
        }
        finally
        {
            _likingId = null;
        }
    }

    private async Task ShareAsync(ActivityDto post)
    {
        _sharingId = post.Id;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsync($"/api/marketplace/activities/{post.Id}/share", null);
            if (!response.IsSuccessStatusCode) return;

            var result = await response.Content.ReadFromJsonAsync<ShareResponse>();
            if (result is null) return;

            try
            {
                await Js.InvokeVoidAsync("navigator.clipboard.writeText", result.ShareUrl);
            }
            catch
            {
                // Still count the share if clipboard is blocked.
            }

            var index = _posts.FindIndex(x => x.Id == post.Id);
            if (index >= 0)
            {
                _posts[index] = _posts[index] with { ShareCount = result.ShareCount };
            }

            _shareFlashId = post.Id;
            _ = ClearShareFlashAsync(post.Id);
        }
        finally
        {
            _sharingId = null;
        }
    }

    private async Task ClearShareFlashAsync(Guid postId)
    {
        await Task.Delay(3200);
        if (_shareFlashId == postId)
        {
            _shareFlashId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CommentAsync(Guid postId, Guid? parentCommentId, Guid? draftKey = null)
    {
        var authorName = GetAuthor(postId).Trim();
        var errorKey = draftKey ?? parentCommentId;
        var body = errorKey is Guid keyed
            ? GetReplyDraft(keyed).Trim()
            : GetDraft(postId).Trim();

        if (errorKey is Guid replyErrorKey)
        {
            _replyErrors[replyErrorKey] = string.Empty;
        }
        else
        {
            _commentErrors[postId] = string.Empty;
        }

        if (string.IsNullOrWhiteSpace(authorName))
        {
            SetError(postId, errorKey, "Enter your name to comment.");
            return;
        }

        if (string.IsNullOrWhiteSpace(body))
        {
            SetError(postId, errorKey, "Write a comment before posting.");
            return;
        }

        _commentingKey = (errorKey ?? postId).ToString();
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync($"/api/marketplace/activities/{postId}/comments", new
            {
                authorName,
                body,
                parentCommentId,
                reactorKey = GuestSession.ReactorKey
            });

            if (!response.IsSuccessStatusCode)
            {
                SetError(postId, errorKey, "Could not post. Try again.");
                return;
            }

            if (errorKey is Guid cleared)
            {
                ResetReplyDraft(cleared);
                _replyingTo = null;
            }
            else
            {
                ResetDraft(postId);
            }

            await LoadAsync();
        }
        catch
        {
            SetError(postId, errorKey, "Could not post. Try again.");
        }
        finally
        {
            _commentingKey = null;
        }
    }

    private void SetError(Guid postId, Guid? errorKey, string message)
    {
        if (errorKey is Guid key)
        {
            _replyErrors[key] = message;
        }
        else
        {
            _commentErrors[postId] = message;
        }
    }

    private async Task DeleteCommentAsync(Guid postId, Guid commentId)
    {
        _deletingCommentId = commentId;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var reactor = Uri.EscapeDataString(GuestSession.ReactorKey ?? string.Empty);
            var response = await client.DeleteAsync($"/api/marketplace/activities/comments/{commentId}?reactorKey={reactor}");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            if (_replyingTo == commentId)
            {
                _replyingTo = null;
            }

            await LoadAsync();
        }
        finally
        {
            _deletingCommentId = null;
        }
    }

    private async Task ReactAsync(Guid postId, Guid commentId, string emoji)
    {
        DismissReactionPicker(commentId);
        StateHasChanged();
        await GuestSession.LoadAsync();
        if (string.IsNullOrWhiteSpace(GuestSession.ReactorKey))
        {
            return;
        }

        _reactingCommentId = commentId;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync($"/api/marketplace/activities/comments/{commentId}/reactions", new
            {
                emoji,
                reactorKey = GuestSession.ReactorKey
            });
            if (!response.IsSuccessStatusCode) return;

            var result = await response.Content.ReadFromJsonAsync<ReactionToggleResponse>();
            if (result is null) return;

            ApplyReactions(postId, commentId, result.Reactions);
        }
        finally
        {
            _reactingCommentId = null;
        }
    }

    private void ApplyReactions(Guid postId, Guid commentId, List<ReactionDto> reactions)
    {
        var postIndex = _posts.FindIndex(x => x.Id == postId);
        if (postIndex < 0) return;

        var post = _posts[postIndex];
        var updatedComments = post.Comments.Select(c =>
        {
            if (c.Id == commentId)
            {
                return c with { Reactions = reactions };
            }

            if (c.Replies.Any(r => r.Id == commentId))
            {
                return c with
                {
                    Replies = c.Replies.Select(r => r.Id == commentId ? r with { Reactions = reactions } : r).ToList()
                };
            }

            return c;
        }).ToList();

        _posts[postIndex] = post with { Comments = updatedComments };
    }

    private static bool BodyOverflows(string? body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return false;
        }

        var lines = body.Replace("\r\n", "\n").Split('\n');
        if (lines.Length > 7)
        {
            return true;
        }

        var estimated = lines.Sum(line => Math.Max(1, (int)Math.Ceiling(line.Length / 62d)));
        return estimated > 7;
    }

    private static int AlbumCount(int count) => Math.Clamp(count, 1, 5);

    private static List<string> PostImages(ActivityDto post)
    {
        if (post.MediaUrls is { Count: > 0 })
        {
            return post.MediaUrls;
        }

        return string.IsNullOrWhiteSpace(post.MediaUrl) ? [] : [post.MediaUrl];
    }

    private void OpenViewer(Guid postId, int index)
    {
        _viewerPostId = postId;
        _viewerIndex = index;
    }

    private void CloseViewer()
    {
        _viewerPostId = null;
        _viewerIndex = 0;
    }

    private void StepViewer(int delta)
    {
        if (_viewerPostId is not Guid postId)
        {
            return;
        }

        var post = _posts.FirstOrDefault(x => x.Id == postId);
        var images = post is null ? [] : PostImages(post);
        if (images.Count == 0)
        {
            CloseViewer();
            return;
        }

        _viewerIndex = (_viewerIndex + delta + images.Count) % images.Count;
    }

    private string ResolveMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        return $"{ApiBase}/{url.TrimStart('/')}";
    }

