@page "/setup-password"
@layout MainLayout
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<p class="section">Opening the farm dashboard to set your password…</p>

@code {
    protected override void OnInitialized()
    {
        var farmBase = (Configuration["Apps:FarmBlazorBaseUrl"] ?? "http://localhost:5083").TrimEnd('/');
        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        var destination = $"{farmBase}/setup-password{current.Query}";
        if (!Uri.TryCreate(destination, UriKind.Absolute, out var target))
        {
            return;
        }

        if (string.Equals(target.Authority, current.Authority, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo(destination, forceLoad: true);
    }
}
