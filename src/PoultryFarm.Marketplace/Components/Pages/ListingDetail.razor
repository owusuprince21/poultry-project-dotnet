@using System.Net.Http.Json
@page "/listings/{Id:guid}"

@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<div class="listing-workspace">
    <div class="listing-workspace-top">
        <a class="back-link" href="/">&larr; Back to catalog</a>
    </div>

    @if (_listing is null)
    {
        <div class="listing-workspace-status">@(_message ?? "Listing not found or no longer published.")</div>
    }
    else
    {
        <div class="listing-workspace-grid">
            <aside class="listing-product">
                <div class="listing-product-media" style="@($"background-image: url('{ProductImage}');")">
                    <span class="tag">@_listing.ListingType</span>
                </div>

                <div class="listing-product-body">
                    <p class="listing-product-farm">@_listing.FarmName</p>
                    <h1>@_listing.Title</h1>
                    <p class="listing-product-desc">@(_listing.Description ?? "No additional description provided.")</p>

                    <div class="listing-product-stats">
                        <div>
                            <span class="stat-label">Price</span>
                            <strong class="price">@(_listing.PriceText ?? "Ask for price")</strong>
                        </div>
                        <div>
                            <span class="stat-label">Available</span>
                            <strong>@ListingQuantityText.Amount(_listing.QuantityOffered, _listing.UnitLabel)</strong>
                        </div>
                    </div>

                    <div class="listing-product-note">
                        Chat with the farm to confirm quantity and delivery. No payment is taken on this marketplace.
                    </div>
                </div>
            </aside>

            <ListingInquiry ListingId="Id"
                            ListingTitle="@_listing.Title"
                            FarmName="@_listing.FarmName" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ListingDto? _listing;
    private string? _message;
    private string ApiBase => (Configuration["Api:PublicBaseUrl"] ?? Configuration["Api:BaseUrl"] ?? "http://localhost:5100").TrimEnd('/');

    private string ProductImage
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_listing?.ImageUrl))
            {
                return ResolveMediaUrl(_listing.ImageUrl);
            }

            return string.Equals(_listing?.ListingType, "Birds", StringComparison.OrdinalIgnoreCase)
                ? "/hero-birds.jpg"
                : "/hero-eggs.jpg";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        try
        {
            _listing = await client.GetFromJsonAsync<ListingDto>($"/api/marketplace/listings/{Id}");
            if (_listing is null)
            {
                _message = "Listing not found or no longer published.";
            }
        }
        catch
        {
            _listing = null;
            _message = "This listing could not be loaded. Go back and try again.";
        }
    }

    private sealed record ListingDto(
        Guid Id,
        Guid CompanyId,
        string FarmName,
        string ListingType,
        string Title,
        string? Description,
        decimal? QuantityOffered,
        string UnitLabel,
        decimal? PriceAmount,
        string? PriceText,
        string? ImageUrl,
        DateTimeOffset? PublishedAt);

    private string ResolveMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        return $"{ApiBase}/{url.TrimStart('/')}";
    }
}
