@using System.Net.Http.Json
@using PoultryFarm.Marketplace.Services
@rendermode InteractiveServer

@page "/listings/{Id:guid}"

@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject GuestSession GuestSession
@inject PersistentComponentState ApplicationState
@implements IDisposable

<div class="listing-workspace">
    <div class="listing-workspace-top">
        <a class="back-link" href="/">&larr; Back to catalog</a>
    </div>

    @if (_loading)
    {
        <div class="listing-workspace-status">Loading listing...</div>
    }
    else if (_listing is null)
    {
        <div class="listing-workspace-status">@(_message ?? "Listing not found or no longer published.")</div>
    }
    else
    {
        <div class="listing-workspace-grid">
            <aside class="listing-product">
                <div class="listing-product-media" style="@($"background-image: url('{ProductImage}');")">
                    <span class="tag">@_listing.ListingType</span>
                </div>

                <div class="listing-product-body">
                    <p class="listing-product-farm">@_listing.FarmName</p>
                    <h1>@_listing.Title</h1>
                    <p class="listing-product-desc">@(_listing.Description ?? "No additional description provided.")</p>

                    <div class="listing-product-stats">
                        <div>
                            <span class="stat-label">Price</span>
                            <strong class="price">@(_listing.PriceText ?? "Ask for price")</strong>
                        </div>
                        <div>
                            <span class="stat-label">Available</span>
                            <strong>@ListingQuantityText.Amount(_listing.QuantityOffered, _listing.UnitLabel)</strong>
                        </div>
                    </div>

                    <div class="listing-product-note">
                        Chat with the farm to confirm quantity and delivery. No payment is taken on this marketplace.
                    </div>
                </div>
            </aside>

            <section class="listing-chat-pane">
                <header class="listing-chat-pane-header">
                    <div>
                        <h2>Message the farm</h2>
                        <p>@_listing.FarmName will reply here to arrange fulfillment.</p>
                    </div>
                    @if (_chatOpen)
                    {
                        <span class="chat-live-pill">Live</span>
                    }
                </header>

                <div class="listing-chat-pane-body">
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <p class="notice">@_message</p>
                    }

                    @if (!_chatOpen)
                    {
                        <div class="chat-start">
                            <p class="chat-start-lead">Share your contact details to start a live chat about this listing.</p>
                            <div class="chat-start-grid">
                                <label>
                                    <span>Name</span>
                                    <input @bind="_buyerName" placeholder="Your full name" autocomplete="name" />
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input @bind="_buyerEmail" type="email" placeholder="you@email.com" autocomplete="email" />
                                </label>
                                <label>
                                    <span>Phone</span>
                                    <input @bind="_buyerPhone" type="tel" placeholder="Phone number" autocomplete="tel" />
                                </label>
                                <label>
                                    <span>Quantity (optional)</span>
                                    <input @bind="_qty" placeholder="e.g. 5 crates" />
                                </label>
                                <label class="full">
                                    <span>First message (optional)</span>
                                    <textarea @bind="_inquiryMessage" placeholder="Tell the farm what you need..." rows="3"></textarea>
                                </label>
                            </div>
                            <div class="chat-start-actions">
                                <button class="btn primary" disabled="@_saving" @onclick="StartChatAsync">
                                    @(_saving ? "Starting..." : "Start chat")
                                </button>
                                <button class="btn secondary" disabled="@_saving" @onclick="LeaveMessageAsync">
                                    Leave a message instead
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ListingChatPanel ListingId="Id"
                                          ListingTitle="@_listing.Title"
                                          FarmName="@_listing.FarmName"
                                          InitialMessage="@_startedMessage" />
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _chatOpen;
    private ListingDto? _listing;
    private string _buyerName = string.Empty;
    private string _buyerEmail = string.Empty;
    private string _buyerPhone = string.Empty;
    private string _qty = string.Empty;
    private string _inquiryMessage = string.Empty;
    private string? _startedMessage;
    private string? _message;
    private string ApiBase => (Configuration["Api:PublicBaseUrl"] ?? Configuration["Api:BaseUrl"] ?? "http://localhost:5100").TrimEnd('/');
    private PersistingComponentStateSubscription _persistingSubscription;
    private bool _guestLoaded;

    private string ProductImage
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_listing?.ImageUrl))
            {
                return ResolveMediaUrl(_listing.ImageUrl);
            }

            return string.Equals(_listing?.ListingType, "Birds", StringComparison.OrdinalIgnoreCase)
                ? "/hero-birds.jpg"
                : "/hero-eggs.jpg";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistListingAsync);
        var stateKey = ListingStateKey();
        if (ApplicationState.TryTakeFromJson(stateKey, out ListingDto? restored) && restored is not null)
        {
            _listing = restored;
            _loading = false;
            return;
        }

        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        try
        {
            _listing = await client.GetFromJsonAsync<ListingDto>($"/api/marketplace/listings/{Id}");
        }
        catch
        {
            _listing = null;
            _message = "This listing could not be loaded. Go back and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _guestLoaded)
        {
            return;
        }

        _guestLoaded = true;
        try
        {
            await GuestSession.LoadAsync();
            if (!GuestSession.IsAuthenticated)
            {
                return;
            }

            _buyerName = GuestSession.DisplayName ?? string.Empty;
            _buyerEmail = GuestSession.Email ?? string.Empty;
            _buyerPhone = GuestSession.Phone ?? string.Empty;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private Task PersistListingAsync()
    {
        ApplicationState.PersistAsJson(ListingStateKey(), _listing);
        return Task.CompletedTask;
    }

    private string ListingStateKey() => $"listing-{Id:N}";

    public void Dispose() => _persistingSubscription.Dispose();

    private async Task StartChatAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_buyerName))
            {
                _message = "Enter your name to start chatting.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_buyerEmail) && string.IsNullOrWhiteSpace(_buyerPhone))
            {
                _message = "Provide an email or phone number.";
                return;
            }

            // Always refresh so a token from a previous DB / session is not reused.
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync("/api/marketplace/guest-session", new
            {
                name = _buyerName,
                email = _buyerEmail,
                phone = _buyerPhone
            });

            if (!response.IsSuccessStatusCode)
            {
                _message = await response.Content.ReadAsStringAsync();
                return;
            }

            var session = await response.Content.ReadFromJsonAsync<GuestSessionDto>();
            if (session is null || string.IsNullOrWhiteSpace(session.Token))
            {
                _message = "Could not create guest session.";
                return;
            }

            await GuestSession.SignInAsync(session.Token, session.UserId, session.DisplayName, session.Email, session.Phone);

            var first = _inquiryMessage.Trim();
            if (!string.IsNullOrWhiteSpace(_qty))
            {
                first = string.IsNullOrWhiteSpace(first)
                    ? $"Hi, I'm interested in {_qty}."
                    : $"{first}\nQuantity: {_qty}";
            }

            _startedMessage = string.IsNullOrWhiteSpace(first) ? null : first;
            _chatOpen = true;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LeaveMessageAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            decimal? qty = decimal.TryParse(_qty, out var parsed) ? parsed : null;
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync("/api/marketplace/inquiries", new
            {
                listingId = Id,
                buyerName = _buyerName,
                buyerEmail = _buyerEmail,
                buyerPhone = _buyerPhone,
                message = string.IsNullOrWhiteSpace(_inquiryMessage) ? "Please contact me about this listing." : _inquiryMessage,
                quantityRequested = qty
            });

            if (!response.IsSuccessStatusCode)
            {
                _message = await response.Content.ReadAsStringAsync();
                return;
            }

            _message = "Message sent. The farm will contact you.";
            _inquiryMessage = string.Empty;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record ListingDto(
        Guid Id,
        Guid CompanyId,
        string FarmName,
        string ListingType,
        string Title,
        string? Description,
        decimal? QuantityOffered,
        string UnitLabel,
        decimal? PriceAmount,
        string? PriceText,
        string? ImageUrl,
        DateTimeOffset? PublishedAt);

    private string ResolveMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        return $"{ApiBase}/{url.TrimStart('/')}";
    }

    private sealed record GuestSessionDto(
        string Token,
        Guid UserId,
        string DisplayName,
        string? Email,
        string? Phone);
}
