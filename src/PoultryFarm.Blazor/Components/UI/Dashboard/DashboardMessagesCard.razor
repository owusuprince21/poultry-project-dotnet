@using MudBlazor

<MudPaper Class="work-surface" Elevation="0">
    <MudText Typo="Typo.h6" Class="font-semibold">
        @Title
    </MudText>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Class="mt-3">
            @((MarkupString)AlertMessage)
        </MudAlert>
    }

    <MudList T="DashboardMessageItem" Dense="true">
        @foreach (var item in Items)
        {
            <MudListItem Icon="@item.Icon">
                @item.Text
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "Messages";

    [Parameter]
    public string? AlertMessage { get; set; }

    [Parameter]
    public IReadOnlyCollection<DashboardMessageItem> Items { get; set; } = [];
}