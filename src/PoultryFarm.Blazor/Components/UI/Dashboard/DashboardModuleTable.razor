@using MudBlazor
@using PoultryFarm.Blazor.Components.UI.Shared

<MudPaper Class="work-surface" Elevation="0">
    <MudText Typo="Typo.h6" Class="font-semibold">
        @Title
    </MudText>

    <MudTable Items="@Items" Dense="true" Hover="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Module</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Priority</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Module">
                @context.Name
            </MudTd>

            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Color="@context.Color"
                         Size="Size.Small">
                    @context.Status
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Priority">
                @context.Priority
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "Modules";

    [Parameter]
    public IReadOnlyCollection<DashboardModuleItem> Items { get; set; } = [];
}