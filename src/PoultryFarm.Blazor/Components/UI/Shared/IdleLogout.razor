@implements IAsyncDisposable
@using PoultryFarm.Blazor.Services
@inject IJSRuntime JSRuntime
@inject PoultryFarm.Blazor.Services.AuthSession AuthSession
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<IdleLogout>? _dotNetRef;
    private int _timeoutMinutes = IdleTimeoutPreferences.DefaultMinutes;
    private bool _started;
    private bool _starting;

    protected override void OnInitialized()
    {
        IdleTimeoutPreferences.Changed += OnPreferenceChangedAsync;
        AuthSession.Changed += OnAuthChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureStartedAsync();
    }

    [JSInvokable]
    public async Task OnIdleTimeout()
    {
        if (!AuthSession.IsAuthenticated)
        {
            return;
        }

        await AuthSession.SignOutAsync();
        var label = _timeoutMinutes == 1 ? "1 minute" : $"{_timeoutMinutes} minutes";
        Snackbar.Add($"You were logged out after {label} of inactivity.", Severity.Info);
        Navigation.NavigateTo("/", replace: true);
    }

    private async Task OnAuthChangedAsync()
    {
        if (!AuthSession.IsAuthenticated)
        {
            await StopWatcherAsync();
            return;
        }

        await EnsureStartedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPreferenceChangedAsync()
    {
        if (_module is null || !AuthSession.IsAuthenticated)
        {
            return;
        }

        _timeoutMinutes = await LoadMinutesAsync();
        await _module.InvokeVoidAsync("updateTimeout", IdleTimeoutPreferences.ToMilliseconds(_timeoutMinutes));
    }

    private async Task EnsureStartedAsync()
    {
        if (_started || _starting || !AuthSession.IsAuthenticated)
        {
            return;
        }

        _starting = true;
        try
        {
            _timeoutMinutes = await LoadMinutesAsync();
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/idleLogout.js");
            await _module.InvokeVoidAsync("start", _dotNetRef, IdleTimeoutPreferences.ToMilliseconds(_timeoutMinutes));
            _started = true;
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task StopWatcherAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _started = false;
    }

    private async Task<int> LoadMinutesAsync()
    {
        try
        {
            var key = IdleTimeoutPreferences.StorageKey(AuthSession.UserId?.ToString());
            var raw = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            if (int.TryParse(raw, out var minutes))
            {
                return IdleTimeoutPreferences.ClampMinutes(minutes);
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore; fall back to default.
        }

        return IdleTimeoutPreferences.DefaultMinutes;
    }

    public async ValueTask DisposeAsync()
    {
        IdleTimeoutPreferences.Changed -= OnPreferenceChangedAsync;
        AuthSession.Changed -= OnAuthChangedAsync;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone; nothing left to clean up in the browser.
            }
        }

        _dotNetRef?.Dispose();
    }
}
