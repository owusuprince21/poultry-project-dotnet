@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject PoultryFarm.Blazor.Services.AuthSession AuthSession
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<IdleLogout>? _dotNetRef;

    [Parameter]
    public int TimeoutMilliseconds { get; set; } = 180000;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is not null || !AuthSession.IsAuthenticated)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/idleLogout.js");
        await _module.InvokeVoidAsync("start", _dotNetRef, TimeoutMilliseconds);
    }

    [JSInvokable]
    public async Task OnIdleTimeout()
    {
        if (!AuthSession.IsAuthenticated)
        {
            return;
        }

        await AuthSession.SignOutAsync();
        Snackbar.Add("You were logged out after 3 minutes of inactivity.", Severity.Info);
        Navigation.NavigateTo("/", replace: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone; nothing left to clean up in the browser.
            }
        }

        _dotNetRef?.Dispose();
    }
}
