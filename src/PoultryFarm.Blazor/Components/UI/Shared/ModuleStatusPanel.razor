@using MudBlazor

<MudPaper Class="work-surface" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icon" Color="@Color" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.subtitle1" Class="font-semibold">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
        </div>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "Module ready";
    [Parameter] public string Description { get; set; } = "This screen is ready for API-backed grids, filters, dialogs, and workflows.";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.CheckCircle;
    [Parameter] public Color Color { get; set; } = Color.Success;
}
