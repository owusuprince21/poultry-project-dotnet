    private static bool CanEditNow(TeamChatMessage message) =>
        message.IsMine && DateTimeOffset.UtcNow - message.SentAt <= MessageActionWindow;

    private static bool CanDeleteNow(TeamChatMessage message) =>
        message.IsMine && DateTimeOffset.UtcNow - message.SentAt <= MessageActionWindow;

    private void AddEmoji(string emoji)
    {
        _message = $"{_message}{emoji}";
    }

    private async Task LoadEmojisAsync()
    {
        _emojisLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var path = Path.Combine(Environment.WebRootPath, "emoji-list.json");
            var json = await File.ReadAllTextAsync(path);
            var emojis = JsonSerializer.Deserialize<string[]>(json) ?? [];
            if (emojis.Length >= 3000)
            {
                Emojis = emojis
                    .Distinct()
                    .Select(x => new EmojiOption { Emoji = x, Annotation = x, Group = "Local emoji library" })
                    .ToArray();
                await InvokeAsync(StateHasChanged);
                return;
            }

            Snackbar.Add($"Emoji library file only has {emojis.Length:N0} emojis. Using fallback emojis.", Severity.Warning);
            Emojis = FallbackEmojiValues.Select(x => new EmojiOption { Emoji = x, Annotation = x, Group = "Fallback" }).ToArray();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Emoji library could not load, using fallback emojis. {ex.Message}", Severity.Warning);
            Emojis = FallbackEmojiValues.Select(x => new EmojiOption { Emoji = x, Annotation = x, Group = "Fallback" }).ToArray();
        }
        finally
        {
            _emojisLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseEmojiPicker()
    {
        _showEmojiPicker = false;
        _emojiSearch = string.Empty;
    }

    private static string EmojiTitle(EmojiOption emoji)
    {
        var title = string.IsNullOrWhiteSpace(emoji.Annotation) ? emoji.Emoji : emoji.Annotation;
        return string.IsNullOrWhiteSpace(emoji.Group) ? title : $"{title} • {emoji.Group}";
    }

    private async Task StartEditAsync(TeamChatMessage message)
    {
        if (!CanEditNow(message))
        {
            Snackbar.Add("Messages can only be edited within the first 10 minutes.", Severity.Warning);
            return;
        }

        _replyTo = null;
        _editingMessage = message;
        _message = message.Body;
        await InvokeAsync(StateHasChanged);
        await FocusComposerAsync();
    }

    private void CancelEdit()
    {
        _editingMessage = null;
        _message = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editingMessage is null || string.IsNullOrWhiteSpace(_message))
        {
            return;
        }

        _sending = true;
        try
        {
            var response = await CreateApiClient().PutAsJsonAsync($"/api/chat/messages/{_editingMessage.Id}", new
            {
                body = _message
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Message could not be edited."), Severity.Error);
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<TeamChatMessage>();
            if (updated is not null)
            {
                UpsertMessage(updated);
            }

            _message = string.Empty;
            _editingMessage = null;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task DeleteMessageAsync(TeamChatMessage message)
    {
        if (!CanDeleteNow(message))
        {
            Snackbar.Add("Messages can only be deleted within the first 10 minutes.", Severity.Warning);
            return;
        }

        var response = await CreateApiClient().DeleteAsync($"/api/chat/messages/{message.Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Message could not be deleted."), Severity.Error);
            return;
        }

        _messages.RemoveAll(x => x.Id == message.Id);
    }

    private void DismissReactionPicker(Guid messageId) => _dismissedReactionMessageId = messageId;

    private void ClearDismissedReaction(Guid messageId)
    {
        if (_dismissedReactionMessageId == messageId)
        {
            _dismissedReactionMessageId = null;
        }
    }

    private async Task ReactAsync(TeamChatMessage message, string emoji)
    {
        DismissReactionPicker(message.Id);
        StateHasChanged();
        var response = await CreateApiClient().PostAsJsonAsync($"/api/chat/messages/{message.Id}/reactions", new
        {
            emoji
        });

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Reaction could not be saved."), Severity.Error);
            return;
        }

        var updated = await response.Content.ReadFromJsonAsync<ChatReactionUpdated>();
        if (updated is not null)
        {
            var index = _messages.FindIndex(x => x.Id == updated.MessageId);
            if (index >= 0)
            {
                _messages[index] = _messages[index] with { Reactions = updated.Reactions };
            }
        }
    }

    private void UpsertMessage(TeamChatMessage message)
    {
        var index = _messages.FindIndex(x => x.Id == message.Id);
        if (index >= 0)
        {
            _messages[index] = message;
        }
        else
        {
            _messages.Add(message);
        }
    }

    private async Task NotifyTypingAsync(bool isTyping, bool force = false)
    {
        if (_selectedContact is null)
        {
            return;
        }

        var now = DateTimeOffset.UtcNow;
        if (!force && isTyping && (now - _lastTypingSentAt).TotalSeconds < 2)
        {
            return;
        }

        _lastTypingSentAt = now;
        try
        {
            if (_hubConnection?.State == HubConnectionState.Connected)
            {
                await _hubConnection.InvokeAsync("SendTyping", _selectedContact.Id, isTyping);
                return;
            }

            await CreateApiClient().PostAsJsonAsync("/api/chat/typing", new
            {
                recipientUserId = _selectedContact.Id,
                isTyping
            });
        }
        catch
        {
            // Typing indicators are best-effort.
        }
    }

    private async Task MarkConversationReadAsync(Guid contactId)
    {
        try
        {
            _unreadByContact.Remove(contactId);
            UpdateContact(contactId, contact => contact with { UnreadCount = 0 });
            await CreateApiClient().PostAsync($"/api/chat/messages/{contactId}/read", null);
        }
        catch
        {
            // Read receipts are retried when the conversation is opened again.
        }
    }

    private async Task ResetTypingAsync(Guid senderUserId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(2500, cancellationToken);
            await InvokeAsync(() =>
            {
                if (_typingContactId == senderUserId)
                {
                    ClearTyping(senderUserId);
                    StateHasChanged();
                }
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void ClearTyping(Guid senderUserId)
    {
        _typingByContact.Remove(senderUserId);
        if (_typingContactId == senderUserId)
        {
            _typingContactId = null;
            _typingDisplayName = null;
        }
    }

    private static string TrimPreview(string text) =>
        text.Length > 80 ? $"{text[..80]}..." : text;

