@page "/daily-summary"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Services

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Daily Summary Report</PageTitle>

<ModulePageShell Title="Daily Summary Report" Subtitle="Record what you saw today. The farm assistant alerts the farm owner and workers with what to do next.">
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudText Typo="Typo.h6" Class="font-semibold">End-of-day observation</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Choose the operation, then describe what you noticed on the farm.</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Date" Date="_date" DateChanged="OnDateChanged" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="int" Label="Operation" @bind-Value="_category" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="0">Eggs observation</MudSelectItem>
                            <MudSelectItem T="int" Value="1">Feed observation</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Birds observation</MudSelectItem>
                            <MudSelectItem T="int" Value="3">General observation</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="What did you observe?" @bind-Value="_notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="6" Placeholder="Example: Afternoon eggs were smaller than usual, and several birds in the brown flock looked dull." />
                    </MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.Send" Disabled="_saving" OnClick="SaveAsync">
                    @(_saving ? "Asking the assistant..." : "Submit observation")
                </MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-semibold">Observations for @((_date ?? DateTime.Today).ToString("MMMM d, yyyy"))</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Each entry includes the assistant's action for the farm.</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" />
                </MudStack>
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_items.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Summarize" Title="No observations yet" Description="Submit eggs, feed, birds, or a general note for this date." />
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var item in _items)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@CategoryLabel(item.Category)</MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.AuthorName · @item.CreatedAt.ToLocalTime().ToString("t")</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="mt-2">@item.Notes</MudText>
                                @if (!string.IsNullOrWhiteSpace(item.Recommendation))
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">@item.Recommendation</MudAlert>
                                }
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</ModulePageShell>

@code {
    private DateTime? _date = DateTime.Today;
    private int _category;
    private string? _notes;
    private bool _saving;
    private bool _loading;
    private List<DailyObservationItem> _items = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        if (AuthSession.MustChangePassword)
        {
            Navigation.NavigateTo("/force-password-change", replace: true);
            return;
        }

        if (!AuthSession.CanAccessPage("daily-summary"))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDateChanged(DateTime? date)
    {
        _date = date;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_date is null)
        {
            return;
        }

        _loading = true;
        try
        {
            var day = DateOnly.FromDateTime(_date.Value);
            var client = CreateClient();
            _items = await client.GetFromJsonAsync<List<DailyObservationItem>>($"/api/reports/daily?date={day:yyyy-MM-dd}") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Daily observations could not load: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_date is null || string.IsNullOrWhiteSpace(_notes))
        {
            Snackbar.Add("Choose a date and write the observation.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("/api/reports/daily", new
            {
                Date = DateOnly.FromDateTime(_date.Value),
                Category = _category,
                Notes = _notes.Trim()
            });
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Observation could not be saved."), Severity.Error);
                return;
            }

            _notes = null;
            Snackbar.Add("Observation sent. The farm owner and workers were notified with what to do.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Observation could not be saved: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private static string CategoryLabel(int category) =>
        category switch
        {
            1 => "Feed observation",
            2 => "Birds observation",
            3 => "General observation",
            _ => "Eggs observation"
        };

    private sealed record DailyObservationItem(Guid Id, DateOnly Date, int Category, string Notes, string? Recommendation, string AuthorName, DateTimeOffset CreatedAt);
}
