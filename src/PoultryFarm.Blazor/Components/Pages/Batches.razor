@page "/batches"

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Components.UI.Shared
@using PoultryFarm.Blazor.Services

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject TableActionConfirm TableActionConfirm

<PageTitle>Batch Management</PageTitle>

<ModulePageShell Title="Batch Management" Subtitle="Track flock placement, survival, growth age, and expected sale readiness.">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="3">
            <DashboardMetricCard Label="Active Batches" Value="@ActiveBatches.Count.ToString("N0")" Detail="currently being managed" Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <DashboardMetricCard Label="Active Birds" Value="@ActiveBatches.Sum(x => x.CurrentCount).ToString("N0")" Detail="available bird count" Icon="@Icons.Material.Filled.Pets" Color="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <DashboardMetricCard Label="Ready Soon" Value="@ActiveBatches.Count(x => DaysToSale(x) <= 14).ToString("N0")" Detail="within 14 days of sale date" Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <DashboardMetricCard Label="Avg Survival" Value="@AverageSurvival" Detail="current birds vs placement" Icon="@Icons.Material.Filled.HealthAndSafety" Color="Color.Info" />
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Class="work-surface pa-4 mt-4">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.h6" Class="font-semibold">Batch growth progress</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Track how far the selected flock has grown between arrival and expected sale day.
                    </MudText>
                </div>
                <MudSelect T="Guid?"
                           Value="_selectedBatchId"
                           ValueChanged="OnSelectedBatchChanged"
                           Label="Selected batch"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width: 16rem;"
                           Clearable="true">
                    @foreach (var batch in _batches)
                    {
                        <MudSelectItem T="Guid?" Value="@batch.Id">@batch.BatchNumber — @batch.Breed</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (SelectedBatch is null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Select a batch (or click a table row) to view growth progress from arrival to expected sale date.
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.subtitle2" Class="font-semibold">
                            @SelectedBatch.BatchNumber · @DisplayBirdType(SelectedBatch.BirdType) · @SelectedBatch.Breed
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GrowthProgressColor(SelectedBatch)" Variant="Variant.Filled">
                            @GrowthProgressPercent(SelectedBatch).ToString("N0")% complete
                        </MudChip>
                    </MudStack>

                    <MudProgressLinear Color="@GrowthProgressColor(SelectedBatch)"
                                       Size="Size.Large"
                                       Value="@GrowthProgressPercent(SelectedBatch)"
                                       Class="rounded-lg"
                                       Style="height: 0.85rem;" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Arrival @SelectedBatch.ArrivalDate.ToString("MMM d, yyyy")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Day @ElapsedGrowthDays(SelectedBatch) of @TotalGrowthDays(SelectedBatch)
                            · @GrowthProgressCaption(SelectedBatch)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Sale @SelectedBatch.ExpectedSaleDate.ToString("MMM d, yyyy")
                        </MudText>
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3" Class="mt-4">
        <MudItem xs="12" lg="4">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudText Typo="Typo.h6" Class="font-semibold">Create Batch</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Set placement date and expected sale date. The dashboard will track age and readiness automatically.</MudText>

                <MudStack Spacing="3">
                    <MudSelect T="int" @bind-Value="_form.BirdType" Label="Bird type" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">Layer</MudSelectItem>
                        <MudSelectItem Value="1">Broiler</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="_form.Breed" Label="Breed" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_form.Supplier" Label="Supplier" Variant="Variant.Outlined" />
                    <MudDatePicker @bind-Date="_form.ArrivalDate" Label="Placement / arrival date" Variant="Variant.Outlined" />
                    <MudDatePicker @bind-Date="_form.ExpectedSaleDate" Label="Expected sale date" Variant="Variant.Outlined" />
                    <MudSelect T="int" @bind-Value="_form.Color" Label="Variant color" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">White</MudSelectItem>
                        <MudSelectItem Value="1">Brown</MudSelectItem>
                        <MudSelectItem Value="2">Black</MudSelectItem>
                        <MudSelectItem Value="3">Speckled</MudSelectItem>
                        <MudSelectItem Value="4">Mixed</MudSelectItem>
                    </MudSelect>
                    <MudNumericField @bind-Value="_form.InitialCount" Label="Initial birds" Variant="Variant.Outlined" Min="1" />
                    <MudTextField @bind-Value="_form.Notes" Label="Notes" Variant="Variant.Outlined" Lines="3" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@_saving" OnClick="CreateBatchAsync">
                        Create Batch
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="8">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-semibold">Batch Readiness</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">From placement day to expected sale day, with survival and variant counts. Click a row to track growth above.</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
                </MudStack>

                <TableExportBar Title="Batch readiness"
                                FileName="batches"
                                Disabled="@(!_batches.Any())"
                                GetPayload="BuildExportPayload" />
                <MudTable T="BatchModel"
                          Items="@_batches"
                          Dense="true"
                          Hover="true"
                          Loading="@_loading"
                          RowsPerPage="10"
                          RowClassFunc="BatchRowClass"
                          OnRowClick="OnBatchRowClick">
                    <HeaderContent>
                        <MudTh>Batch</MudTh>
                        <MudTh>Breed</MudTh>
                        <MudTh>Arrival</MudTh>
                        <MudTh>Age</MudTh>
                        <MudTh>Birds</MudTh>
                        <MudTh>Survival</MudTh>
                        <MudTh>Sale Date</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Batch">
                            <MudText Typo="Typo.body2" Class="font-semibold">@context.BatchNumber</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@DisplayBirdType(context.BirdType)</MudText>
                        </MudTd>
                        <MudTd DataLabel="Breed">@context.Breed</MudTd>
                        <MudTd DataLabel="Arrival">@context.ArrivalDate.ToString("MMM d, yyyy")</MudTd>
                        <MudTd DataLabel="Age">@AgeInWeeks(context) weeks</MudTd>
                        <MudTd DataLabel="Birds">@context.CurrentCount.ToString("N0") / @context.InitialCount.ToString("N0")</MudTd>
                        <MudTd DataLabel="Survival">@context.SurvivalRate.ToString("N1")%</MudTd>
                        <MudTd DataLabel="Sale Date">@context.ExpectedSaleDate.ToString("MMM d, yyyy")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@ReadinessColor(context)" Variant="Variant.Outlined">@ReadinessText(context)</MudChip>
                        </MudTd>
                        <MudTd>
                            @if (context.Status == 0)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.PointOfSale" OnClick="@(() => MarkReadyForSaleAsync(context))">Mark ready for sale</MudMenuItem>
                                </MudMenu>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No batches have been created for this farm yet.</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <TablePager />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</ModulePageShell>

@code {
    private readonly BatchForm _form = new();
    private List<BatchModel> _batches = [];
    private Guid? _selectedBatchId;
    private bool _loading;
    private bool _saving;

    private IReadOnlyCollection<BatchModel> ActiveBatches => _batches.Where(x => x.Status == 0).ToList();

    private BatchModel? SelectedBatch =>
        _selectedBatchId is Guid id ? _batches.FirstOrDefault(x => x.Id == id) : null;

    private string AverageSurvival =>
        ActiveBatches.Count == 0 ? "0%" : $"{ActiveBatches.Average(x => x.SurvivalRate):N1}%";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();
        _form.CompanyId = AuthSession.CompanyId ?? Guid.Empty;
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _batches = await CreateApiClient().GetFromJsonAsync<List<BatchModel>>("/api/batches") ?? [];
            if (_selectedBatchId is Guid selected && _batches.All(x => x.Id != selected))
            {
                _selectedBatchId = null;
            }

            if (_selectedBatchId is null && _batches.Count > 0)
            {
                _selectedBatchId = ActiveBatches.FirstOrDefault()?.Id ?? _batches[0].Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Batches could not load: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnSelectedBatchChanged(Guid? batchId)
    {
        _selectedBatchId = batchId;
        return Task.CompletedTask;
    }

    private void OnBatchRowClick(TableRowClickEventArgs<BatchModel> args)
    {
        if (args.Item is null)
        {
            return;
        }

        _selectedBatchId = args.Item.Id;
    }

    private string BatchRowClass(BatchModel batch, int _) =>
        batch.Id == _selectedBatchId ? "mud-theme-primary mud-opacity-10 cursor-pointer" : "cursor-pointer";

    private async Task CreateBatchAsync()
    {
        if (_form.CompanyId == Guid.Empty || string.IsNullOrWhiteSpace(_form.Breed) || _form.InitialCount <= 0)
        {
            Snackbar.Add("Breed, company, and initial birds are required.", Severity.Warning);
            return;
        }

        if (_form.ExpectedSaleDate < _form.ArrivalDate)
        {
            Snackbar.Add("Expected sale date cannot be before placement date.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var response = await CreateApiClient().PostAsJsonAsync("/api/batches", _form.ToRequest());
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Batch could not be created."), Severity.Error);
                return;
            }

            Snackbar.Add("Batch created successfully.", Severity.Success);
            _form.Reset(AuthSession.CompanyId ?? Guid.Empty);
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task MarkReadyForSaleAsync(BatchModel batch)
    {
        if (!await TableActionConfirm.ConfirmAsync("mark ready for sale", batch.BatchNumber))
        {
            return;
        }

        var response = await CreateApiClient().PostAsync($"/api/batches/{batch.Id}/mark-sold", null);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Batch could not be marked ready for sale."), Severity.Error);
            return;
        }

        Snackbar.Add("Batch marked ready for bird sales.", Severity.Success);
        await LoadAsync();
    }

    private HttpClient CreateApiClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private static int AgeInWeeks(BatchModel batch)
    {
        var days = DateOnly.FromDateTime(DateTime.Today).DayNumber - batch.ArrivalDate.DayNumber;
        return Math.Max(0, days / 7);
    }

    private static int DaysToSale(BatchModel batch) =>
        batch.ExpectedSaleDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;

    private static int TotalGrowthDays(BatchModel batch)
    {
        var span = batch.ExpectedSaleDate.DayNumber - batch.ArrivalDate.DayNumber;
        return Math.Max(span, 1);
    }

    private static int ElapsedGrowthDays(BatchModel batch)
    {
        var today = DateOnly.FromDateTime(DateTime.Today).DayNumber;
        var elapsed = today - batch.ArrivalDate.DayNumber;
        return Math.Clamp(elapsed, 0, TotalGrowthDays(batch));
    }

    private static double GrowthProgressPercent(BatchModel batch)
    {
        var today = DateOnly.FromDateTime(DateTime.Today).DayNumber;
        if (today <= batch.ArrivalDate.DayNumber)
        {
            return 0;
        }

        if (today >= batch.ExpectedSaleDate.DayNumber)
        {
            return 100;
        }

        return Math.Round(100.0 * (today - batch.ArrivalDate.DayNumber) / TotalGrowthDays(batch), 1);
    }

    private static string GrowthProgressCaption(BatchModel batch)
    {
        var days = DaysToSale(batch);
        if (days < 0)
        {
            return $"{Math.Abs(days)} day(s) past expected sale";
        }

        if (days == 0)
        {
            return "Expected sale day today";
        }

        return $"{days} day(s) until expected sale";
    }

    private static Color GrowthProgressColor(BatchModel batch)
    {
        var percent = GrowthProgressPercent(batch);
        if (percent >= 100)
        {
            return Color.Success;
        }

        if (percent >= 75)
        {
            return Color.Warning;
        }

        return Color.Info;
    }

    private static string ReadinessText(BatchModel batch)
    {
        var days = DaysToSale(batch);
        if (days <= 0)
        {
            return "Ready for sale";
        }

        if (days <= 14)
        {
            return $"{days} days left";
        }

        return "Growing";
    }

    private static Color ReadinessColor(BatchModel batch)
    {
        var days = DaysToSale(batch);
        if (days <= 0)
        {
            return Color.Success;
        }

        if (days <= 14)
        {
            return Color.Warning;
        }

        return Color.Info;
    }

    private TableExportPayload BuildExportPayload()
    {
        var headers = new[]
        {
            "Batch Number", "Bird Type", "Breed", "Arrival Date", "Age (weeks)", "Current Count", "Initial Count",
            "Survival Rate", "Expected Sale Date", "Growth %", "Status / Readiness"
        };
        var rows = _batches.Select(x => (IReadOnlyList<string>)
        [
            x.BatchNumber,
            DisplayBirdType(x.BirdType),
            x.Breed,
            x.ArrivalDate.ToString("MMM d, yyyy"),
            AgeInWeeks(x).ToString(),
            x.CurrentCount.ToString("N0"),
            x.InitialCount.ToString("N0"),
            $"{x.SurvivalRate:N1}%",
            x.ExpectedSaleDate.ToString("MMM d, yyyy"),
            $"{GrowthProgressPercent(x):N0}%",
            ReadinessText(x)
        ]).ToList();

        return new TableExportPayload("Batch Readiness", headers, rows, $"Exported {DateTime.Now:g}");
    }

    private sealed class BatchForm
    {
        public Guid CompanyId { get; set; }
        public int BirdType { get; set; }
        public string Breed { get; set; } = string.Empty;
        public string? Supplier { get; set; }
        public DateTime? ArrivalDate { get; set; } = DateTime.Today;
        public DateTime? ExpectedSaleDate { get; set; } = DateTime.Today.AddDays(72 * 7);
        public int Color { get; set; } = 1;
        public int InitialCount { get; set; } = 1000;
        public string? Notes { get; set; }

        public object ToRequest() => new
        {
            CompanyId,
            BirdType,
            ArrivalDate = DateOnly.FromDateTime(ArrivalDate ?? DateTime.Today),
            Breed,
            Supplier,
            ExpectedSaleDate = DateOnly.FromDateTime(ExpectedSaleDate ?? DateTime.Today),
            Notes,
            Variants = new[]
            {
                new
                {
                    Color,
                    InitialCount,
                    Notes
                }
            }
        };

        public void Reset(Guid companyId)
        {
            CompanyId = companyId;
            BirdType = 0;
            Breed = string.Empty;
            Supplier = null;
            ArrivalDate = DateTime.Today;
            ExpectedSaleDate = DateTime.Today.AddDays(72 * 7);
            Color = 1;
            InitialCount = 1000;
            Notes = null;
        }
    }

    private sealed record BatchModel(
        Guid Id,
        Guid CompanyId,
        string BatchNumber,
        int BirdType,
        DateOnly ArrivalDate,
        string Breed,
        string? Supplier,
        DateOnly ExpectedSaleDate,
        int Status,
        int InitialCount,
        int CurrentCount,
        decimal SurvivalRate,
        IReadOnlyCollection<BatchVariantModel> Variants);

    private sealed record BatchVariantModel(
        Guid Id,
        int Color,
        int EggColor,
        int InitialCount,
        int CurrentCount,
        string? Notes);

    private static string DisplayBirdType(int value) =>
        value == 1 ? "Broiler" : "Layer";
}
