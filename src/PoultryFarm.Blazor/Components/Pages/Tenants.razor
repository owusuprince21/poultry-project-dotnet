@page "/tenants"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Components.UI.Shared
@using PoultryFarm.Blazor.Services

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Tenants</PageTitle>

@if (!_loaded)
{
    <PageLoader Message="Loading tenants..." />
}
else if (!AuthSession.IsSuperAdmin)
{
    <ModulePageShell Title="Tenants" Subtitle="This workspace is available to super admins only.">
        <ModuleStatusPanel Title="Restricted workspace" Description="Tenant governance is reserved for super administrators." Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
    </ModulePageShell>
}
else
{
    <ModulePageShell Title="Tenants" Subtitle="Tenant health, activity, and platform-level governance.">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="3">
                <DashboardMetricCard Label="Tenants" Value="@_tenants.Count.ToString("N0")" Detail="@($"{_tenants.Count(x => x.IsActive):N0} active")" Icon="@Icons.Material.Filled.Apartment" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <DashboardMetricCard Label="Farm Users" Value="@_tenants.Sum(x => x.TotalUsers).ToString("N0")" Detail="@($"{_tenants.Sum(x => x.FarmAdmins):N0} admins / {_tenants.Sum(x => x.Workers):N0} workers")" Icon="@Icons.Material.Filled.Groups" Color="Color.Success" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <DashboardMetricCard Label="Active Batches" Value="@_tenants.Sum(x => x.ActiveBatches).ToString("N0")" Detail="@($"{_tenants.Sum(x => x.ActiveBirds):N0} active birds")" Icon="@Icons.Material.Filled.Agriculture" Color="Color.Warning" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <DashboardMetricCard Label="Blocked Users" Value="@_tenants.Sum(x => x.BlockedUsers).ToString("N0")" Detail="requires admin review" Icon="@Icons.Material.Filled.Security" Color="Color.Error" />
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200 mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Tenant Register</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudDatePicker @bind-Date="_fromDate" Label="From" Variant="Variant.Outlined" />
                    <MudDatePicker @bind-Date="_toDate" Label="To" Variant="Variant.Outlined" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="LoadAsync">Apply</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Default" OnClick="ClearFiltersAsync" />
                </MudStack>
            </MudStack>
            <TableExportBar Title="Tenant register"
                            FileName="tenants"
                            Disabled="@(!_tenants.Any())"
                            GetPayload="BuildExportPayload" />
            <MudTable Items="_tenants" Dense="true" Hover="true" RowsPerPage="10">
                <HeaderContent>
                    <MudTh>Tenant</MudTh>
                    <MudTh>Code</MudTh>
                    <MudTh>Users</MudTh>
                    <MudTh>Farm Activity</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Created</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tenant">
                        <MudText Typo="Typo.body2" Class="font-semibold">@context.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TenantContact(context)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Code"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Code</MudChip></MudTd>
                    <MudTd DataLabel="Users">@context.TotalUsers total (@context.FarmAdmins admins, @context.Workers workers)</MudTd>
                    <MudTd DataLabel="Farm Activity">@context.ActiveBatches batches / @context.ActiveBirds birds</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Created">@context.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No tenants found.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <TablePager />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </ModulePageShell>
}

@code {
    private List<TenantOverview> _tenants = [];
    private bool _loaded;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (AuthSession.MustChangePassword)
        {
            Navigation.NavigateTo("/force-password-change", replace: true);
            return;
        }

        if (AuthSession.IsSuperAdmin)
        {
            await LoadAsync();
        }

        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        try
        {
            _tenants = await CreateApiClient().GetFromJsonAsync<List<TenantOverview>>($"/api/platform/tenants{DateQuery}") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Tenants error: {ex.Message}", Severity.Error);
        }
    }

    private HttpClient CreateApiClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private static string TenantContact(TenantOverview tenant) =>
        new[] { tenant.Email, tenant.Phone }.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "No contact";

    private TableExportPayload BuildExportPayload()
    {
        var headers = new[] { "Tenant", "Code", "Email", "Phone", "Users", "Admins", "Workers", "Batches", "Birds", "Status", "Created" };
        var rows = _tenants.Select(x => (IReadOnlyList<string>)
        [
            x.Name,
            x.Code,
            x.Email ?? string.Empty,
            x.Phone ?? string.Empty,
            x.TotalUsers.ToString("N0"),
            x.FarmAdmins.ToString("N0"),
            x.Workers.ToString("N0"),
            x.ActiveBatches.ToString("N0"),
            x.ActiveBirds.ToString("N0"),
            x.IsActive ? "Active" : "Inactive",
            x.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")
        ]).ToList();

        return new TableExportPayload("Tenant Register", headers, rows, $"Exported {DateTime.Now:g}");
    }

    private async Task ClearFiltersAsync()
    {
        _fromDate = null;
        _toDate = null;
        await LoadAsync();
    }

    private string DateQuery
    {
        get
        {
            var values = new List<string>();
            if (_fromDate.HasValue)
            {
                values.Add($"from={Uri.EscapeDataString(new DateTimeOffset(_fromDate.Value.Date).ToString("O"))}");
            }

            if (_toDate.HasValue)
            {
                values.Add($"to={Uri.EscapeDataString(new DateTimeOffset(_toDate.Value.Date.AddDays(1).AddTicks(-1)).ToString("O"))}");
            }

            return values.Count == 0 ? string.Empty : "?" + string.Join("&", values);
        }
    }
}
