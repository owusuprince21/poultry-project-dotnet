@page "/daily-summary"

@using PoultryFarm.Blazor.Components.UI.Shared

<PageTitle>@Module.Title</PageTitle>

<ModulePageShell Title="@Module.Title" Subtitle="@Module.Subtitle">
    <MudGrid Spacing="3">
        @foreach (var metric in Module.Metrics)
        {
            <MudItem xs="12" sm="6" lg="3">
                <DashboardMetricCard Label="@metric.Label" Value="@metric.Value" Detail="@metric.Detail" Icon="@metric.Icon" Color="@metric.Color" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-4">
        <MudItem xs="12" lg="8">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudText Typo="Typo.h6" Class="font-semibold">@Module.WorkspaceTitle</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@Module.WorkspaceSubtitle</MudText>

                <MudGrid Spacing="2">
                    @foreach (var workflow in Module.Workflows)
                    {
                        <MudItem xs="12" md="6">
                            <div class="operation-card">
                                <MudIcon Icon="@workflow.Icon" Color="@workflow.Color" />
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-semibold">@workflow.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@workflow.Detail</MudText>
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Elevation="0" Class="work-surface pa-4">
                <MudText Typo="Typo.h6" Class="font-semibold">MVP Wiring</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@Module.Readiness</MudText>
                <MudStack Spacing="2">
                    @foreach (var step in Module.NextSteps)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">@step</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</ModulePageShell>

