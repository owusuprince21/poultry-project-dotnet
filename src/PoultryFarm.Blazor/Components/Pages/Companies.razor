@page "/companies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Services
@using PoultryFarm.Blazor.Components.UI.Shared

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Companies</PageTitle>

@if (!_loaded)
{
    <PageLoader Message="Loading company workspace..." />
}
else if (!AuthSession.IsSuperAdmin)
{
    <ModulePageShell Title="Companies" Subtitle="This workspace is available to super admins only.">
        <ModuleStatusPanel Title="Restricted workspace" Description="Company onboarding is reserved for super administrators." Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
    </ModulePageShell>
}
else
{
    <ModulePageShell Title="Companies" Subtitle="Create companies and review users grouped under each company.">
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@(_editingCompany is null ? "Create Company" : "Update Company")</MudText>
                        <MudTextField @bind-Value="_companyForm.Name" Label="Company name" Variant="Variant.Outlined" Required="true" />
                        <MudTextField @bind-Value="_companyForm.Email" Label="Email" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_companyForm.Phone" Label="Phone" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_companyForm.Address" Label="Address" Variant="Variant.Outlined" Lines="3" />
                        @if (_editingCompany is not null)
                        {
                            <MudSwitch T="bool" @bind-Value="_companyForm.IsActive" Color="Color.Success" Label="Company active" />
                        }
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@(_editingCompany is null ? Icons.Material.Filled.AddBusiness : Icons.Material.Filled.Save)"
                                       Disabled="_savingCompany"
                                       OnClick="SaveCompanyAsync">
                                @(_savingCompany ? "Saving..." : _editingCompany is null ? "Create Company" : "Update Company")
                            </MudButton>
                            @if (_editingCompany is not null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEdit">
                                    Cancel
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200">
                    <MudText Typo="Typo.h6" Class="mb-3">Company Register</MudText>
                    <MudTable Items="_companies" Dense="true" Hover="true" Bordered="false" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Code</MudTh>
                            <MudTh>Contact</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Code">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Code</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Contact">@CompanyContact(context)</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(context.IsActive ? Color.Success : Color.Error)"
                                         Variant="Variant.Outlined">
                                    @(context.IsActive ? "Active" : "Inactive")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEdit(context))">Edit</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteCompanyAsync(context))">Delete</MudMenuItem>
                                </MudMenu>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No companies have been created yet.</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200">
                    <MudText Typo="Typo.h6" Class="mb-3">Users By Company</MudText>
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (var group in UsersByCompany)
                        {
                            <MudExpansionPanel Text="@($"{group.Key} ({group.Count()} users)")">
                                <MudTable Items="group" Dense="true" Hover="true" RowsPerPage="10">
                                    <HeaderContent>
                                        <MudTh>User</MudTh>
                                        <MudTh>Username</MudTh>
                                        <MudTh>Role</MudTh>
                                        <MudTh>First Login</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="User">@UserFullName(context)</MudTd>
                                        <MudTd DataLabel="Username">@context.Username</MudTd>
                                        <MudTd DataLabel="Role">@DisplayRole(context.Role)</MudTd>
                                        <MudTd DataLabel="First Login">@(context.MustChangePassword ? "Password change required" : "Completed")</MudTd>
                                    </RowTemplate>
                                    <PagerContent>
                                        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                                    </PagerContent>
                                </MudTable>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ModulePageShell>
}

@code {
    private UpdateCompanyModel _companyForm = new();
    private ManagedCompany? _editingCompany;
    private List<ManagedCompany> _companies = [];
    private List<ManagedUser> _users = [];
    private bool _loaded;
    private bool _savingCompany;

    private IEnumerable<IGrouping<string, ManagedUser>> UsersByCompany =>
        _users
            .GroupBy(x => string.IsNullOrWhiteSpace(x.CompanyName) ? "System Users" : x.CompanyName)
            .OrderBy(x => x.Key);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();

        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (AuthSession.MustChangePassword)
        {
            Navigation.NavigateTo("/force-password-change", replace: true);
            return;
        }

        if (AuthSession.IsSuperAdmin)
        {
            await LoadAsync();
        }

        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var client = CreateApiClient();
        try
        {
            _companies = await client.GetFromJsonAsync<List<ManagedCompany>>("/api/companies") ?? [];
            _users = await client.GetFromJsonAsync<List<ManagedUser>>("/api/users") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "Companies could not be loaded.", client.BaseAddress), Severity.Error);
        }
    }

    private async Task SaveCompanyAsync()
    {
        if (string.IsNullOrWhiteSpace(_companyForm.Name))
        {
            Snackbar.Add("Company name is required.", Severity.Error);
            return;
        }

        _savingCompany = true;

        try
        {
            var client = CreateApiClient();
            var response = _editingCompany is null
                ? await client.PostAsJsonAsync("/api/companies", _companyForm)
                : await client.PutAsJsonAsync($"/api/companies/{_editingCompany.Id}", _companyForm);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Company could not be saved."), Severity.Error);
                return;
            }

            Snackbar.Add(_editingCompany is null ? "Company created successfully." : "Company updated successfully.", Severity.Success);
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "Company could not be saved.", CreateApiClient().BaseAddress), Severity.Error);
        }
        finally
        {
            _savingCompany = false;
        }
    }

    private void BeginEdit(ManagedCompany company)
    {
        _editingCompany = company;
        _companyForm = new UpdateCompanyModel
        {
            Name = company.Name,
            Email = company.Email,
            Phone = company.Phone,
            Address = company.Address,
            IsActive = company.IsActive
        };
    }

    private void CancelEdit()
    {
        _editingCompany = null;
        _companyForm = new UpdateCompanyModel();
    }

    private async Task DeleteCompanyAsync(ManagedCompany company)
    {
        try
        {
            var client = CreateApiClient();
            var response = await client.DeleteAsync($"/api/companies/{company.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "Company could not be deleted."), Severity.Error);
                return;
            }

            Snackbar.Add("Company deleted successfully.", Severity.Success);
            if (_editingCompany?.Id == company.Id)
            {
                CancelEdit();
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "Company could not be deleted.", CreateApiClient().BaseAddress), Severity.Error);
        }
    }

    private HttpClient CreateApiClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private static string CompanyContact(ManagedCompany company) =>
        new[] { company.Email, company.Phone }.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "Not provided";

    private static string UserFullName(ManagedUser user)
    {
        var fullName = $"{user.FirstName} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? user.Username : fullName;
    }

    private static string DisplayRole(string role) =>
        role switch
        {
            "super_admin" => "Super Admin",
            "sub_admin" => "Sub Admin",
            "system_admin" => "System Admin",
            "farm_admin" => "Farm Admin",
            "worker" => "Worker",
            _ => role
        };
}
