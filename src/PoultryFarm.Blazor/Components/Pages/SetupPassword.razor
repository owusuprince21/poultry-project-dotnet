@page "/setup-password"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout PoultryFarm.Blazor.Components.Layout.AuthLayout

@using System.Net.Http.Json
@using PoultryFarm.Blazor.Services

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Set your password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-6 rounded-lg border border-slate-200" Elevation="0">
        <MudText Typo="Typo.h5" Class="mb-2">Set your farm admin password</MudText>
        <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
            Use the invitation link from your approval email to set a password, then sign in to the farm dashboard.
        </MudText>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_token" Label="Invite token" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_password"
                          Label="New password"
                          Variant="Variant.Outlined"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentAriaLabel="Show or hide password" />
            <MudTextField @bind-Value="_confirm"
                          Label="Confirm password"
                          Variant="Variant.Outlined"
                          InputType="@ConfirmInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@ConfirmIcon"
                          OnAdornmentClick="ToggleConfirmVisibility"
                          AdornmentAriaLabel="Show or hide confirm password" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SubmitAsync">
                @(_saving ? "Saving..." : "Set password")
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _token = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private bool _saving;
    private bool _showPassword;
    private bool _showConfirm;

    private InputType PasswordInputType => _showPassword ? InputType.Text : InputType.Password;
    private InputType ConfirmInputType => _showConfirm ? InputType.Text : InputType.Password;
    private string PasswordIcon => _showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string ConfirmIcon => _showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmVisibility() => _showConfirm = !_showConfirm;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("token", out var token))
        {
            _token = token.ToString();
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            var response = await client.PostAsJsonAsync("/api/auth/password/setup", new
            {
                token = _token,
                newPassword = _password,
                confirmPassword = _confirm
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiErrorFormatter.FormatHttpAsync(response), Severity.Error);
                return;
            }

            Snackbar.Add("Password set. You can sign in.", Severity.Success);
            Navigation.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
