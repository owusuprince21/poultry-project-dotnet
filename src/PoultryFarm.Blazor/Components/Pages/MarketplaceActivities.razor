@page "/marketplace/activities"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Services
@using PoultryFarm.Blazor.Components.UI.Shared

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject TableActionConfirm TableActionConfirm

<PageTitle>Marketplace Activities</PageTitle>

@if (!_loaded)
{
    <PageLoader Message="Loading activities..." />
}
else if (!AuthSession.IsFarmAdmin && !AuthSession.IsSystemAdmin && !AuthSession.CanAccessPage("marketplace"))
{
    <ModulePageShell Title="Marketplace Activities" Subtitle="Share farm updates on the public marketplace.">
        <ModuleStatusPanel Title="Restricted" Description="Farm admins and workers with marketplace access can post activities." Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
    </ModulePageShell>
}
else
{
    <ModulePageShell Title="Publish farm posts" Subtitle="Post photos and updates for the public marketplace. Anyone can like, comment, and share there — no login required.">
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Engagement (likes, comments, shares) happens on the public marketplace feed.
                <MudLink Href="@MarketplaceFeedUrl" Target="_blank">Open marketplace activity feed</MudLink>
            </MudAlert>

            <MudPaper Class="pa-4 rounded-lg border border-slate-200" Elevation="0">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">@(_editingId is null ? "New post" : "Edit post")</MudText>
                    <MudTextField @bind-Value="_title" Label="Headline (optional)" Variant="Variant.Outlined" Placeholder="Short headline — or leave blank" />
                    <MudTextField @bind-Value="_body" Label="What's happening on your farm?" Variant="Variant.Outlined" Lines="4" Placeholder="Share an update, tip, or photo moment..." />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-size-medium mud-ripple">
                            <span class="mud-button-label" style="display:inline-flex;align-items:center;gap:.35rem;cursor:pointer;">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                @(_uploading ? "Uploading..." : _mediaUrls.Count == 0 ? "Add photos" : "Add more photos")
                            </span>
                            <InputFile OnChange="OnMediaSelected" accept="image/jpeg,image/png,image/webp,image/gif" multiple style="display:none" disabled="@(_uploading || _mediaUrls.Count >= MaxPhotos)" />
                        </label>
                        @if (_mediaUrls.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_mediaUrls.Count of @MaxPhotos photos</MudText>
                        }
                        <MudSpacer />
                        <MudSwitch T="bool" @bind-Value="_publishNow" Label="Publish" Color="Color.Success" />
                        @if (_editingId is not null)
                        {
                            <MudButton Variant="Variant.Text" Disabled="_saving || _uploading" OnClick="CancelEdit">Cancel</MudButton>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || _uploading || string.IsNullOrWhiteSpace(_body)" OnClick="SaveAsync">
                            @(_saving ? "Saving..." : _editingId is null ? "Post" : "Save")
                        </MudButton>
                    </MudStack>
                    @if (_mediaUrls.Count > 0)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:.6rem;">
                            @for (var index = 0; index < _mediaUrls.Count; index++)
                            {
                                var photoIndex = index;
                                <div style="position:relative;width:140px;">
                                    <MudImage Src="@ResolveMediaUrl(_mediaUrls[photoIndex])" Alt="Post photo" Class="rounded-lg" Style="height:110px;object-fit:cover;width:140px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Style="position:absolute;top:2px;right:2px;background:#fff;" OnClick="@(() => _mediaUrls.RemoveAt(photoIndex))" />
                                </div>
                            }
                        </div>
                    }
                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.h6">Your posts</MudText>
            @if (_myPosts.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No posts yet. Publish your first update above.</MudAlert>
            }
            else
            {
                @foreach (var post in _myPosts)
                {
                    <MudPaper Class="pa-4 rounded-lg border border-slate-200" Elevation="0" @key="post.Id">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                <div>
                                    <MudText Typo="Typo.subtitle1">@post.Title</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @(post.IsPublished ? "Published" : "Draft")
                                        · @(post.PublishedAt?.ToLocalTime().ToString("g") ?? post.CreatedAt.ToLocalTime().ToString("g"))
                                    </MudText>
                                </div>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    @if (CanEdit(post))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => StartEdit(post))">Edit</MudMenuItem>
                                    }
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteAsync(post.Id, post.Title))">Delete</MudMenuItem>
                                </MudMenu>
                            </MudStack>
                            <MudText Typo="Typo.body1" Style="white-space:pre-wrap;">@post.Body</MudText>
                            @{
                                var photos = post.MediaUrls is { Count: > 0 }
                                    ? post.MediaUrls
                                    : string.IsNullOrWhiteSpace(post.MediaUrl) ? [] : new List<string> { post.MediaUrl };
                            }
                            @if (photos.Count > 0)
                            {
                                <div style="display:flex;flex-wrap:wrap;gap:.45rem;">
                                    @foreach (var photo in photos)
                                    {
                                        <MudImage Src="@ResolveMediaUrl(photo)" Alt="@post.Title" Class="rounded-lg" Style="height:120px;width:160px;object-fit:cover;" />
                                    }
                                </div>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @post.LikeCount likes · @post.CommentCount comments · @post.ShareCount shares on marketplace
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudStack>
    </ModulePageShell>
}

@code {
    private const int MaxPhotos = 10;
    private bool _loaded;
    private bool _saving;
    private bool _uploading;
    private bool _publishNow = true;
    private string _title = string.Empty;
    private string _body = string.Empty;
    private Guid? _editingId;
    private List<string> _mediaUrls = [];
    private List<ActivityRow> _myPosts = [];
    private string ApiBase => (Configuration["Api:PublicBaseUrl"] ?? Configuration["Api:BaseUrl"] ?? "http://localhost:5100").TrimEnd('/');
    private string MarketplaceFeedUrl => $"{(Configuration["Apps:MarketplaceBaseUrl"] ?? "http://localhost:5084").TrimEnd('/')}/activities";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthSession.LoadAsync();
        if (!AuthSession.IsAuthenticated) { Navigation.NavigateTo("/", replace: true); return; }
        if (AuthSession.MustChangePassword) { Navigation.NavigateTo("/force-password-change", replace: true); return; }
        if (AuthSession.IsFarmAdmin || AuthSession.IsSystemAdmin || AuthSession.CanAccessPage("marketplace"))
        {
            await LoadAsync();
        }
        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var client = CreateApiClient();
        _myPosts = await client.GetFromJsonAsync<List<ActivityRow>>("/api/marketplace/farm/activities") ?? [];
    }

    private async Task OnMediaSelected(InputFileChangeEventArgs args)
    {
        var room = MaxPhotos - _mediaUrls.Count;
        if (room <= 0)
        {
            Snackbar.Add($"You can add up to {MaxPhotos} photos on one post.", Severity.Warning);
            return;
        }

        IReadOnlyList<IBrowserFile> picked;
        try
        {
            picked = args.GetMultipleFiles(MaxPhotos);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add($"Choose up to {MaxPhotos} photos.", Severity.Warning);
            return;
        }

        var files = picked.Take(room).ToList();
        if (files.Count == 0)
        {
            return;
        }

        if (picked.Count > room)
        {
            Snackbar.Add($"A post can hold {MaxPhotos} photos, so only {room} more {(room == 1 ? "was" : "were")} added.", Severity.Info);
        }

        _uploading = true;
        try
        {
            var client = CreateApiClient();
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var content = new MultipartFormDataContent();
                var streamContent = new StreamContent(stream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);
                content.Add(new StringContent("activities"), "folder");

                var response = await client.PostAsync("/api/marketplace/farm/uploads", content);
                if (!response.IsSuccessStatusCode)
                {
                    Snackbar.Add(await ApiErrorFormatter.FormatHttpAsync(response), Severity.Error);
                    continue;
                }

                var uploaded = await response.Content.ReadFromJsonAsync<UploadResponse>();
                if (!string.IsNullOrWhiteSpace(uploaded?.Url))
                {
                    _mediaUrls.Add(uploaded.Url);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private bool CanEdit(ActivityRow post) =>
        post.CreatedByUserId is null
            ? AuthSession.IsFarmAdmin || AuthSession.IsSystemAdmin
            : post.CreatedByUserId == AuthSession.UserId;

    private void StartEdit(ActivityRow post)
    {
        _editingId = post.Id;
        _title = post.Title;
        _body = post.Body;
        _publishNow = post.IsPublished;
        _mediaUrls = post.MediaUrls is { Count: > 0 }
            ? post.MediaUrls.ToList()
            : string.IsNullOrWhiteSpace(post.MediaUrl) ? [] : [post.MediaUrl];
    }

    private void CancelEdit()
    {
        _editingId = null;
        _title = string.Empty;
        _body = string.Empty;
        _mediaUrls = [];
        _publishNow = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var client = CreateApiClient();
            var payload = new
            {
                title = string.IsNullOrWhiteSpace(_title) ? null : _title,
                body = _body,
                mediaUrl = _mediaUrls.FirstOrDefault(),
                mediaUrls = _mediaUrls,
                publishNow = _publishNow
            };
            var response = _editingId is Guid id
                ? await client.PutAsJsonAsync($"/api/marketplace/farm/activities/{id}", payload)
                : await client.PostAsJsonAsync("/api/marketplace/farm/activities", payload);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiErrorFormatter.FormatHttpAsync(response), Severity.Error);
                return;
            }

            var wasEdit = _editingId is not null;
            var published = _publishNow;
            CancelEdit();
            Snackbar.Add(wasEdit ? "Post updated." : published ? "Published to marketplace." : "Draft saved.", Severity.Success);
            await LoadAsync();
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id, string title)
    {
        if (!await TableActionConfirm.ConfirmAsync("delete", title))
        {
            return;
        }

        var client = CreateApiClient();
        await client.DeleteAsync($"/api/marketplace/farm/activities/{id}");
        await LoadAsync();
    }

    private string ResolveMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        return $"{ApiBase}/{url.TrimStart('/')}";
    }

    private HttpClient CreateApiClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private sealed record ActivityRow(Guid Id, string Title, string Body, string? MediaUrl, bool IsPublished, DateTimeOffset? PublishedAt, DateTimeOffset CreatedAt, int LikeCount, int CommentCount, int ShareCount, List<string>? MediaUrls, Guid? CreatedByUserId);
    private sealed record UploadResponse(string Url);
}
