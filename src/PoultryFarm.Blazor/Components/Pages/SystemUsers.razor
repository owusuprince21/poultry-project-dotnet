@page "/system-users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PoultryFarm.Blazor.Services
@using PoultryFarm.Blazor.Components.UI.Shared

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>System Users</PageTitle>

@if (!_loaded)
{
    <PageLoader Message="Loading system users..." />
}
else if (!AuthSession.IsSuperAdmin)
{
    <ModulePageShell Title="System Users" Subtitle="This workspace is available to super admins only.">
        <ModuleStatusPanel Title="Restricted workspace" Description="Only super administrators can manage system users." Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
    </ModulePageShell>
}
else
{
    <ModulePageShell Title="System Users" Subtitle="Manage superusers and system administrator accounts only.">
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@(_editingUser is null ? "Create System User" : "Update System User")</MudText>
                        <MudSelect T="string" @bind-Value="_systemForm.Role" Label="System role" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("super_admin")">Super Admin</MudSelectItem>
                            <MudSelectItem T="string" Value="@("sub_admin")">Sub Admin</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_systemForm.FirstName" Label="First name" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_systemForm.LastName" Label="Last name" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_systemForm.Email" Label="Email" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_systemForm.Username" Label="Username" Variant="Variant.Outlined" />
                        @if (_editingUser is null)
                        {
                            <MudTextField @bind-Value="_systemForm.Password"
                                          Label="Temporary password"
                                          Variant="Variant.Outlined"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="@(() => _showPassword = !_showPassword)" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Password reset will be added separately.
                            </MudAlert>
                        }
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@(_editingUser is null ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Save)"
                                       Disabled="_savingUser"
                                       OnClick="SaveSystemUserAsync">
                                @(_savingUser ? "Saving..." : _editingUser is null ? "Create System User" : "Update User")
                            </MudButton>
                            @if (_editingUser is not null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEdit">
                                    Cancel
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200">
                    <MudText Typo="Typo.h6" Class="mb-3">System Administrators</MudText>
                    <MudTable Items="_systemUsers" Dense="true" Hover="true" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Username</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Password</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@UserFullName(context)</MudTd>
                            <MudTd DataLabel="Username">@context.Username</MudTd>
                            <MudTd DataLabel="Email">@(context.Email ?? "Not provided")</MudTd>
                            <MudTd DataLabel="Role">
                                <MudChip T="string" Size="Size.Small" Color="@RoleColor(context.Role)" Variant="Variant.Outlined">
                                    @DisplayRole(context.Role)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                                    @(context.IsActive ? "Active" : "Blocked")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Password">@(context.MustChangePassword ? "Must change" : "Changed")</MudTd>
                            <MudTd>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEdit(context))">Edit</MudMenuItem>
                                    @if (!IsCurrentUser(context) && context.IsActive)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="@(() => ToggleStatusAsync(context))">Block</MudMenuItem>
                                    }
                                    else if (!IsCurrentUser(context))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" OnClick="@(() => ToggleStatusAsync(context))">Activate</MudMenuItem>
                                    }
                                    @if (!IsCurrentUser(context))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteUserAsync(context))">Delete</MudMenuItem>
                                    }
                                </MudMenu>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No system users found.</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ModulePageShell>
}

@code {
    private CreateSystemUserModel _systemForm = new();
    private ManagedUser? _editingUser;
    private List<ManagedUser> _systemUsers = [];
    private bool _loaded;
    private bool _savingUser;
    private bool _showPassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();

        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (AuthSession.MustChangePassword)
        {
            Navigation.NavigateTo("/force-password-change", replace: true);
            return;
        }

        if (AuthSession.IsSuperAdmin)
        {
            await LoadAsync();
        }

        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var client = CreateApiClient();
        try
        {
            _systemUsers = await client.GetFromJsonAsync<List<ManagedUser>>("/api/users/system") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "System users could not be loaded.", client.BaseAddress), Severity.Error);
        }
    }

    private async Task SaveSystemUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_systemForm.FirstName) || string.IsNullOrWhiteSpace(_systemForm.LastName))
        {
            Snackbar.Add("First name and last name are required.", Severity.Error);
            return;
        }

        if (_editingUser is null && (string.IsNullOrWhiteSpace(_systemForm.Username) || string.IsNullOrWhiteSpace(_systemForm.Password)))
        {
            Snackbar.Add("Username and temporary password are required.", Severity.Error);
            return;
        }

        _savingUser = true;

        try
        {
            var client = CreateApiClient();
            HttpResponseMessage response;

            if (_editingUser is null)
            {
                response = await client.PostAsJsonAsync("/api/users/system", _systemForm);
            }
            else
            {
                var update = new UpdateManagedUserModel
                {
                    Role = _systemForm.Role,
                    Username = _systemForm.Username,
                    FirstName = _systemForm.FirstName,
                    LastName = _systemForm.LastName,
                    Email = _systemForm.Email
                };
                response = await client.PutAsJsonAsync($"/api/users/{_editingUser.Id}", update);
            }

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "System user could not be saved."), Severity.Error);
                return;
            }

            Snackbar.Add(_editingUser is null ? "System user created successfully." : "System user updated successfully.", Severity.Success);
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "System user could not be saved.", CreateApiClient().BaseAddress), Severity.Error);
        }
        finally
        {
            _savingUser = false;
        }
    }

    private void BeginEdit(ManagedUser user)
    {
        _editingUser = user;
        _systemForm = new CreateSystemUserModel
        {
            Username = user.Username,
            FirstName = user.FirstName ?? string.Empty,
            LastName = user.LastName ?? string.Empty,
            Email = user.Email,
            Role = user.Role
        };
    }

    private void CancelEdit()
    {
        _editingUser = null;
        _systemForm = new CreateSystemUserModel();
    }

    private async Task ToggleStatusAsync(ManagedUser user)
    {
        try
        {
            var client = CreateApiClient();
            var action = user.IsActive ? "block" : "activate";
            var response = await client.PostAsync($"/api/users/{user.Id}/{action}", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "User status could not be updated."), Severity.Error);
                return;
            }

            Snackbar.Add(user.IsActive ? "System user blocked." : "System user activated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "User status could not be updated.", CreateApiClient().BaseAddress), Severity.Error);
        }
    }

    private async Task DeleteUserAsync(ManagedUser user)
    {
        try
        {
            var client = CreateApiClient();
            var response = await client.DeleteAsync($"/api/users/{user.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(ApiErrorFormatter.Format(await response.Content.ReadAsStringAsync(), "User could not be deleted."), Severity.Error);
                return;
            }

            Snackbar.Add("System user deleted successfully.", Severity.Success);
            if (_editingUser?.Id == user.Id)
            {
                CancelEdit();
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.FormatException(ex, "User could not be deleted.", CreateApiClient().BaseAddress), Severity.Error);
        }
    }

    private HttpClient CreateApiClient()
    {
        var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);
        return client;
    }

    private static string UserFullName(ManagedUser user)
    {
        var fullName = $"{user.FirstName} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? user.Username : fullName;
    }

    private static string DisplayRole(string role) =>
        role switch
        {
            "super_admin" => "Super Admin",
            "sub_admin" => "Sub Admin",
            "system_admin" => "System Admin",
            _ => role
        };

    private static Color RoleColor(string role) =>
        role switch
        {
            "super_admin" => Color.Primary,
            "system_admin" => Color.Primary,
            "sub_admin" => Color.Info,
            _ => Color.Default
        };

    private bool IsCurrentUser(ManagedUser user) =>
        AuthSession.UserId == user.Id ||
        string.Equals(AuthSession.Username, user.Username, StringComparison.OrdinalIgnoreCase);
}
