@page "/force-password-change"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout PoultryFarm.Blazor.Components.Layout.AuthLayout

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using PoultryFarm.Blazor.Services

@inject AuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Change Password</PageTitle>

<main class="login-page force-password-page">
    <section class="login-visual">
        <div class="login-shade">
            <img src="/logo.png" alt="Poultry Farm logo" class="login-logo" />
            <MudText Typo="Typo.h3" Class="login-title">Secure your account</MudText>
            <MudText Typo="Typo.subtitle1" Class="login-copy">Create a new password before entering the farm operations workspace.</MudText>
        </div>
    </section>

    <section class="login-panel">
        <MudPaper Class="login-card" Elevation="0">
            <MudText Typo="Typo.h4" Class="font-bold">Change password</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">This is required the first time you sign in.</MudText>

            <MudForm Class="login-form">
                <MudTextField @bind-Value="_currentPassword" Label="Current password" Variant="Variant.Outlined" InputType="@CurrentPasswordInputType" Adornment="Adornment.End" AdornmentIcon="@CurrentPasswordIcon" OnAdornmentClick="@ToggleCurrentPasswordVisibility" />
                <MudTextField @bind-Value="_newPassword" Label="New password" Variant="Variant.Outlined" InputType="@NewPasswordInputType" Adornment="Adornment.End" AdornmentIcon="@NewPasswordIcon" OnAdornmentClick="@ToggleNewPasswordVisibility" />
                <MudTextField @bind-Value="_confirmPassword" Label="Confirm password" Variant="Variant.Outlined" InputType="@ConfirmPasswordInputType" Adornment="Adornment.End" AdornmentIcon="@ConfirmPasswordIcon" OnAdornmentClick="@ToggleConfirmPasswordVisibility" />
                <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" Class="login-button">
                    @(_busy ? "Updating..." : "Update password")
                </MudButton>
            </MudForm>
        </MudPaper>
    </section>
</main>

@code {
    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;
    private bool _busy;
    private bool _showCurrentPassword;
    private bool _showNewPassword;
    private bool _showConfirmPassword;

    private InputType CurrentPasswordInputType => _showCurrentPassword ? InputType.Text : InputType.Password;
    private InputType NewPasswordInputType => _showNewPassword ? InputType.Text : InputType.Password;
    private InputType ConfirmPasswordInputType => _showConfirmPassword ? InputType.Text : InputType.Password;

    private string CurrentPasswordIcon => _showCurrentPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string NewPasswordIcon => _showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string ConfirmPasswordIcon => _showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void ToggleCurrentPasswordVisibility() => _showCurrentPassword = !_showCurrentPassword;
    private void ToggleNewPasswordVisibility() => _showNewPassword = !_showNewPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.LoadAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword != _confirmPassword)
        {
            Snackbar.Add("New password and confirmation must match.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var client = HttpClientFactory.CreateClient("PoultryFarm.Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthSession.Token);

            var response = await client.PostAsJsonAsync("/api/auth/password/force-change", new
            {
                currentPassword = _currentPassword,
                newPassword = _newPassword,
                confirmPassword = _confirmPassword
            });

            if (!response.IsSuccessStatusCode)
            {
                var rawResponse = await response.Content.ReadAsStringAsync();
                Snackbar.Add(ApiErrorFormatter.Format(rawResponse, "Password change failed."), Severity.Error);
                return;
            }

            await AuthSession.MarkPasswordChangedAsync();
            Snackbar.Add("Password updated.", Severity.Success);
            Navigation.NavigateTo("/dashboard", replace: true);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"API connection error: {ex.Message}", Severity.Error);
        }
        catch (JsonException ex)
        {
            Snackbar.Add($"Invalid API response format: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Password change error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
